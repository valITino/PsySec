{
  "name": "psyber",
  "private": true,
  "type": "module",
  "description": "PSYber Web-Plattform: psyber.tech, forms.psyber.tech, surprise.psyber.tech und api.psyber.tech",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev:web": "pnpm --filter @psyber/web dev",
    "dev:forms": "pnpm --filter @psyber/forms dev",
    "dev:surprise": "pnpm --filter @psyber/surprise dev",
    "dev:api": "pnpm --filter @psyber/api dev",
    "build": "pnpm --recursive --filter \"./apps/*\" build && node scripts/build-turnstile.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --recursive typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "budgets": "node scripts/check-budgets.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "assets": "node scripts/brand-assets.ts",
    "export": "node scripts/export-d1.mjs",
    "analyze": "node scripts/analyze.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@psyber/config": "workspace:*",
    "@psyber/survey": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "fontkit": "^2.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wawoff2": "^2.0.1"
  }
}
