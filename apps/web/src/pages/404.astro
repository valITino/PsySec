---
import Button from '@psyber/ui/components/Button.astro';
import { href } from '../config/site.ts';
import Page from '../layouts/Page.astro';
---

<Page
  title="404 – Layer 8 nicht gefunden – PSYber"
  description="Diese Seite gibt es nicht."
  path="/404"
  noindex
>
  <section class="section wrap notfound">
    <p class="hexnum" aria-hidden="true">
      0x194
    </p>
    <h1 class="display h1">404 – Layer 8 nicht gefunden.</h1>
    <div class="card card-deep notfound-terminal mono">
      <p>
        <span class="prompt" aria-hidden="true">
          $
        </span>{' '}
        ping diese-seite
      </p>
      <p class="notfound-out">ping: Seite nicht gefunden</p>
    </div>
    <Button href={href('/')} icon>
      Zur Startseite
    </Button>
  </section>
</Page>

<style>
  .notfound {
    display: grid;
    justify-items: start;
    gap: 2rem;
    min-height: 60svh;
    align-content: center;
  }

  .notfound-terminal {
    display: grid;
    gap: 0.375rem;
    width: min(100%, 34rem);
    padding: 1.25rem 1.5rem;
    font-size: var(--fs-small);
  }

  .prompt {
    margin-right: 0.5rem;
    color: var(--amber);
  }

  .notfound-terminal p:first-child {
    color: var(--lav);
  }

  .notfound-out {
    color: var(--white);
  }
</style>
