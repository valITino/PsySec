---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Ablauf from '../components/sections/Ablauf.astro';
import Check from '../components/sections/Check.astro';
import Drehbuch from '../components/sections/Drehbuch.astro';
import ErsterSchritt from '../components/sections/ErsterSchritt.astro';
import Faq from '../components/sections/Faq.astro';
import Haltung from '../components/sections/Haltung.astro';
import Hero from '../components/sections/Hero.astro';
import Kontakt from '../components/sections/Kontakt.astro';
import Loesungen from '../components/sections/Loesungen.astro';
import Maschen from '../components/sections/Maschen.astro';
import Pakete from '../components/sections/Pakete.astro';
