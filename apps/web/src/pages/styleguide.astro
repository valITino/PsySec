---
/**
 * Unverlinkte Styleguide-Seite (noindex): zeigt Tokens und Bausteine aus packages/ui.
 */
import Button from '@psyber/ui/components/Button.astro';
import Card from '@psyber/ui/components/Card.astro';
import Icon from '@psyber/ui/components/Icon.astro';
import Kicker from '@psyber/ui/components/Kicker.astro';
import Logo from '@psyber/ui/components/Logo.astro';
import PsiIcon from '@psyber/ui/components/PsiIcon.astro';
import PsiNet from '@psyber/ui/components/PsiNet.astro';
import Tag from '@psyber/ui/components/Tag.astro';
import Wordmark from '@psyber/ui/components/Wordmark.astro';
import { iconData, type IconName } from '@psyber/ui/icons';
import { href } from '../config/site.ts';
import Base from '../layouts/Base.astro';

const colors = [
  { token: '--night', hex: '#140a29', use: 'Seitenhintergrund', swatch: 'bg-night' },
  { token: '--aubergine', hex: '#261547', use: 'Karten, erhöhte Flächen', swatch: 'bg-aubergine' },
  { token: '--deep', hex: '#1b0d35', use: 'Terminal, tiefe Panels', swatch: 'bg-deep' },
  { token: '--line', hex: '#3d2b68', use: 'Linien und Rahmen', swatch: 'bg-line' },
  { token: '--lav', hex: '#ad9bf6', use: 'Akzent, Sekundärtext', swatch: 'bg-lav' },
  { token: '--soft', hex: '#e7e1fb', use: 'Fliesstext auf dunkel', swatch: 'bg-soft' },
  { token: '--white', hex: '#ffffff', use: 'Überschriften auf dunkel', swatch: 'bg-white' },
  { token: '--violet', hex: '#6b40c9', use: 'Primärbuttons', swatch: 'bg-violet' },
  { token: '--violet-dark', hex: '#492293', use: 'Hover und Active', swatch: 'bg-violet-dark' },
  { token: '--amber', hex: '#f9ad26', use: 'Warnsignale, sparsam', swatch: 'bg-amber' },
  { token: '--paper', hex: '#f5f4fd', use: 'Helle Fläche', swatch: 'bg-paper' },
  { token: '--ink', hex: '#22172f', use: 'Text auf hell', swatch: 'bg-ink' },
  { token: '--muted', hex: '#675e76', use: 'Sekundärtext auf hell', swatch: 'bg-muted' },
];

const status = [
  { name: 'Gut', hex: '#0ca30c', icon: 'circle-check', swatch: 'text-ok' },
  { name: 'Warnung', hex: '#fab219', icon: 'triangle-alert', swatch: 'text-warn' },
  { name: 'Kritisch', hex: '#d03b3b', icon: 'octagon-x', swatch: 'text-crit' },
] as const;

const icons = Object.keys(iconData) as IconName[];
---

<Base
  title="Styleguide – PSYber"
  description="Tokens und Bausteine des PSYber-Designsystems."
  path="/styleguide"
  noindex
>
  <header class="wrap sg-head net-texture">
    <Logo href={href('/')} />
    <Kicker class="mt-16">Designsystem</Kicker>
    <h1 class="display h1 mt-4">Styleguide</h1>
    <p class="lead mt-6">
      Sauber, modern, minimalistisch und trotzdem aussagekräftig. Aubergine statt Schwarz, Recursive
      mit allen Achsen, Hex statt Versalien. Diese Seite ist nicht verlinkt und nicht indexiert.
    </p>
  </header>

  <section class="wrap sg-section" aria-labelledby="sg-farben">
    <p class="hexnum" aria-hidden="true">
      0x01
    </p>
    <h2 id="sg-farben" class="h2 mt-3">
      Farben
    </h2>
    <ul class="sg-swatches mt-10">
      {colors.map((color) => (
        <li class="card sg-swatch">
          <span class:list={['sg-chip', color.swatch]} />
          <span class="mono small text-fg-strong">{color.token}</span>
          <span class="mono meta">{color.hex}</span>
          <span class="meta">{color.use}</span>
        </li>
      ))}
    </ul>
    <h3 class="h4 mt-12">Statusfarben: nie ohne Icon und Text</h3>
    <ul class="mt-4 flex flex-wrap gap-6">
      {status.map((item) => (
        <li class="flex items-center gap-2">
          <Icon name={item.icon} class={item.swatch} />
          <span>{item.name}</span>
          <span class="mono meta">{item.hex}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-typo">
    <p class="hexnum" aria-hidden="true">
      0x02
    </p>
    <h2 id="sg-typo" class="h2 mt-3">
      Typografie
    </h2>
    <div class="sg-rows mt-10">
      <div class="sg-row">
        <p class="mono meta">Display H1 · wght 900 · CASL 1</p>
        <p class="display h1">Ein Klick zu viel?</p>
      </div>
      <div class="sg-row">
        <p class="mono meta">H2 · wght 850 · CASL 0.8</p>
        <p class="display h2">Zwei Einfallstore. Derselbe Schaden.</p>
      </div>
      <div class="sg-row">
        <p class="mono meta">H3 · wght 800 · CASL 0.6</p>
        <p class="h3 text-fg-strong">Layer 8: Menschen stärken</p>
      </div>
      <div class="sg-row">
        <p class="mono meta">Lead</p>
        <p class="lead">
          Betrüger hacken keine Router, sondern Menschen. PSYber zeigt Ihrer Familie, wie
          Manipulation funktioniert, und sichert Ihr Heimnetz gleich mit ab.
        </p>
      </div>
      <div class="sg-row">
        <p class="mono meta">Fliesstext · wght 400 · 17–18 px · 1.55</p>
        <p class="measure">
          Ein Anruf der ‹Polizei›, eine Deepfake-Werbung, eine Online-Liebe, die plötzlich Geld
          braucht. Solche Angriffe zielen auf Gefühle, nicht auf Technik. <strong>Fett</strong>,{' '}
          <em>kursiv</em> und ein{' '}
          <a class="link" href="#sg-typo">
            Link im Text
          </a>
          .
        </p>
      </div>
      <div class="sg-row">
        <p class="mono meta">Kicker und Abschnittsnummer · MONO 1</p>
        <div class="flex flex-wrap items-baseline gap-6">
          <span class="hexnum">0x0A</span>
          <Kicker as="span">So arbeiten wir</Kicker>
        </div>
      </div>
      <div class="sg-row">
        <p class="mono meta">Grosse Zahl · proportionale Ziffern</p>
        <p class="num">15,9 %</p>
      </div>
      <div class="sg-row">
        <p class="mono meta">Code · MONO 1 · tabular-nums</p>
        <p class="mono tabular">$ ping familie.local · 64’733 Meldungen · CHF 190.–</p>
      </div>
    </div>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-marke">
    <p class="hexnum" aria-hidden="true">
      0x03
    </p>
    <h2 id="sg-marke" class="h2 mt-3">
      Marke
    </h2>
    <div class="sg-brand mt-10">
      <Card class="sg-brand-cell">
        <p class="mono meta">Wortmarke</p>
        <Wordmark class="sg-wordmark" />
      </Card>
      <Card class="sg-brand-cell">
        <p class="mono meta">Psi-Icon</p>
        <div class="flex items-end gap-6 text-lav">
          <PsiIcon size={72} label="Psi-Icon" />
          <PsiIcon size={40} />
          <PsiIcon size={24} />
          <PsiIcon size={16} />
        </div>
      </Card>
      <Card class="sg-brand-cell">
        <p class="mono meta">Logo</p>
        <Logo />
      </Card>
      <Card class="sg-brand-cell sg-psi" tone="deep" data-psi-tilt>
        <p class="mono meta">Key Visual «Psi-Netz» (animiert)</p>
        <PsiNet animated label="Psi-Netz: ein Psi aus Netzwerkknoten" class="sg-psi-net" />
      </Card>
      <Card class="sg-brand-cell sg-psi on-paper">
        <p class="mono meta">Psi-Netz auf hell (statisch)</p>
        <PsiNet class="sg-psi-net sg-psi-paper" />
      </Card>
    </div>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-buttons">
    <p class="hexnum" aria-hidden="true">
      0x04
    </p>
    <h2 id="sg-buttons" class="h2 mt-3">
      Buttons
    </h2>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <Button href="#sg-buttons" icon>
        Zur Umfrage
      </Button>
      <Button href="#sg-buttons" variant="secondary">
        So funktioniert’s
      </Button>
      <Button size="sm">Klein, 44 px</Button>
      <Button disabled>Deaktiviert</Button>
      <a class="btn-text" href="#sg-buttons">
        Textlink mit Pfeil <Icon name="arrow-right" size={18} class="icon-shift" />
      </a>
    </div>
    <div class="on-paper sg-paper mt-8">
      <p class="mono meta">Auf heller Fläche</p>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button href="#sg-buttons" icon>
          Session anfragen
        </Button>
        <Button href="#sg-buttons" variant="secondary">
          Pakete ansehen
        </Button>
        <a class="link" href="#sg-buttons">
          Link im Text
        </a>
      </div>
    </div>
    <p class="meta mt-6">
      Fokus-Ring: 3 px Amber mit 3 px Abstand. Bitte mit der Tab-Taste durch die Buttons gehen.
    </p>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-karten">
    <p class="hexnum" aria-hidden="true">
      0x05
    </p>
    <h2 id="sg-karten" class="h2 mt-3">
      Karten und Tags
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <Card hover>
        <h3 class="h3">Sie werden manipuliert.</h3>
        <p class="mt-4">Karte auf Aubergine. Hover hebt sie um 2 px und färbt den Rahmen.</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          <Tag as="li">Phishing</Tag>
          <Tag as="li">Romance Scam</Tag>
          <Tag as="li" tone="amber">
            Zeitdruck
          </Tag>
        </ul>
      </Card>
      <Card tone="deep">
        <p class="mono small text-lav">$ whoami</p>
        <p class="mono small mt-2">[TODO: Name]</p>
        <p class="mono small text-lav mt-4">$ cat rolle.txt</p>
        <p class="mono small mt-2">Tiefe Karte für Terminal und Code.</p>
      </Card>
      <Card tone="flat">
        <Tag tone="solid">Neu</Tag>
        <h3 class="h3 mt-4">Flache Karte</h3>
        <p class="mt-4">Nur Rahmen, ohne Fläche. Für Listen und ruhige Bereiche.</p>
      </Card>
    </div>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-form">
    <p class="hexnum" aria-hidden="true">
      0x06
    </p>
    <h2 id="sg-form" class="h2 mt-3">
      Formularfelder
    </h2>
    <form class="mt-10 grid max-w-xl gap-6" novalidate>
      <div class="field">
        <label class="label" for="sg-name">
          Name
        </label>
        <input class="input" id="sg-name" type="text" placeholder="Vorname Nachname" />
      </div>
      <div class="field">
        <label class="label" for="sg-mail">
          E-Mail
        </label>
        <input
          class="input"
          id="sg-mail"
          type="email"
          value="keine-adresse"
          aria-invalid="true"
          aria-describedby="sg-mail-error"
        />
        <p class="field-error" id="sg-mail-error">
          <Icon name="circle-alert" size={18} />
          <span>Bitte geben Sie eine gültige E-Mail-Adresse ein.</span>
        </p>
      </div>
      <div class="field">
        <label class="label" for="sg-msg">
          Nachricht <span class="label-hint">(optional)</span>
        </label>
        <textarea class="input" id="sg-msg" placeholder="Was beschäftigt Sie?"></textarea>
      </div>
      <label class="check">
        <input class="checkbox" type="checkbox" />
        <span>Ich habe die Datenschutzerklärung gelesen.</span>
      </label>
    </form>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-icons">
    <p class="hexnum" aria-hidden="true">
      0x07
    </p>
    <h2 id="sg-icons" class="h2 mt-3">
      Icons
    </h2>
    <p class="meta mt-4">Lucide, 1.5 px Strich bei 20 px. Emojis nur in Beispiel-Chats.</p>
    <ul class="sg-icons mt-8">
      {icons.map((name) => (
        <li>
          <Icon name={name} size={20} />
          <span class="mono">{name}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-motion">
    <p class="hexnum" aria-hidden="true">
      0x08
    </p>
    <h2 id="sg-motion" class="h2 mt-3">
      Motion
    </h2>
    <dl class="sg-motion mt-10">
      <div>
        <dt class="mono">--dur-1</dt>
        <dd>150 ms · Hover, Farbe</dd>
      </div>
      <div>
        <dt class="mono">--dur-2</dt>
        <dd>250 ms · Übergänge, Karten</dd>
      </div>
      <div>
        <dt class="mono">--dur-3</dt>
        <dd>400 ms · Einblenden</dd>
      </div>
      <div>
        <dt class="mono">--dur-4</dt>
        <dd>800 ms · Headline-Maske</dd>
      </div>
      <div>
        <dt class="mono">--ease</dt>
        <dd>cubic-bezier(.2,.7,.2,1) · GSAP power3.out</dd>
      </div>
    </dl>
    <p class="measure mt-8">
      Nur sieben bewusst gesetzte Momente bewegen sich. Bei
      <code>prefers-reduced-motion</code> ist alles sofort sichtbar und vollständig; Lenis bleibt
      aus.
    </p>
  </section>
</Base>

<script>
  import { initPsiNet } from '@psyber/ui/motion';

  initPsiNet();
</script>

<style>
  .sg-head {
    padding-block: 2rem clamp(3rem, 8vw, 6rem);
  }

  .sg-section {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--border);
  }

  .sg-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: 1rem;
  }

  .sg-swatch {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem;
  }

  .sg-chip {
    height: 4.5rem;
    margin-bottom: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .sg-rows {
    display: grid;
    gap: 2.5rem;
  }

  .sg-row {
    display: grid;
    gap: 0.75rem;
  }

  .sg-brand {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .sg-brand-cell {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  :global(.sg-wordmark) {
    font-size: clamp(3rem, 8vw, 5rem);
  }

  .sg-psi {
    --psi-bg: var(--deep);
  }

  .sg-psi.on-paper {
    --psi-bg: var(--white);
    --psi-line: var(--violet);
    --psi-node: var(--violet-dark);
  }

  :global(.sg-psi-net) {
    width: min(100%, 13rem);
    margin-inline: auto;
  }

  .sg-paper {
    padding: 1.5rem;
    border-radius: var(--r-card);
  }

  .sg-icons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.75rem 1rem;
    font-size: var(--fs-micro);
    color: var(--fg-muted);
  }

  .sg-icons li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .sg-icons :global(.icon) {
    color: var(--fg-strong);
  }

  .sg-motion {
    display: grid;
    gap: 0.75rem;
  }

  .sg-motion div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
  }

  .sg-motion dt {
    color: var(--accent);
    font-size: var(--fs-small);
  }
</style>
