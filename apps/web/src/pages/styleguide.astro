---
/**
 * Unverlinkte Styleguide-Seite (noindex): zeigt Tokens und Bausteine aus packages/ui.
 */
import Button from '@psyber/ui/components/Button.astro';
import Card from '@psyber/ui/components/Card.astro';
import Icon from '@psyber/ui/components/Icon.astro';
import Kicker from '@psyber/ui/components/Kicker.astro';
import Logo from '@psyber/ui/components/Logo.astro';
import Owl from '@psyber/ui/components/Owl.astro';
import OwlLive from '@psyber/ui/components/OwlLive.astro';
import Tag from '@psyber/ui/components/Tag.astro';
import logoClaimUrl from '@psyber/ui/brand/logo-claim-dark.svg?url';
import stickerBlick from '@psyber/ui/brand/sticker-blick.svg?url';
import stickerGeklickt from '@psyber/ui/brand/sticker-geklickt.svg?url';
import stickerVersuch from '@psyber/ui/brand/sticker-netter-versuch.svg?url';
import wordmarkUrl from '@psyber/ui/brand/wordmark.svg?url';
import { iconData, type IconName } from '@psyber/ui/icons';
import { href } from '../config/site.ts';
import Base from '../layouts/Base.astro';

const colors = [
  { token: '--void', hex: '#08080b', use: 'Seitenhintergrund', swatch: 'bg-void' },
  { token: '--carbon', hex: '#111115', use: 'Karten, Panels', swatch: 'bg-carbon' },
  { token: '--graphite', hex: '#1a1a20', use: 'Erhöhte Fläche in Karten', swatch: 'bg-graphite' },
  { token: '--pit', hex: '#0c0c10', use: 'Terminal, Eingabefelder', swatch: 'bg-pit' },
  { token: '--hairline', hex: '#27272f', use: 'Linien auf Schwarz', swatch: 'bg-hairline' },
  { token: '--steel', hex: '#6d6d79', use: 'Rahmen von Bedienelementen', swatch: 'bg-steel' },
  { token: '--ash', hex: '#9c9ca6', use: 'Sekundärtext auf Schwarz', swatch: 'bg-ash' },
  { token: '--bone', hex: '#f4f4ef', use: 'Text und Überschriften', swatch: 'bg-bone' },
  { token: '--space', hex: '#3d1e86', use: 'Violette Bogen', swatch: 'bg-space' },
  { token: '--nebula', hex: '#b678f7', use: 'Lichtschein, nie für Text', swatch: 'bg-nebula' },
  { token: '--haze', hex: '#cfc8e2', use: 'Sekundärtext auf Space', swatch: 'bg-haze' },
  { token: '--acid', hex: '#c9fb52', use: 'Aktion, Fokus, «gepatcht»', swatch: 'bg-acid' },
  { token: '--amber', hex: '#f9ad26', use: 'Warnsignale, sparsam', swatch: 'bg-amber' },
];

const status = [
  { name: 'Gut', hex: '#0ca30c', icon: 'circle-check', swatch: 'text-ok' },
  { name: 'Warnung', hex: '#fab219', icon: 'triangle-alert', swatch: 'text-warn' },
  { name: 'Kritisch', hex: '#d03b3b', icon: 'octagon-x', swatch: 'text-crit' },
] as const;

const icons = Object.keys(iconData) as IconName[];
---

<Base
  title="Styleguide – PSYber"
  description="Tokens und Bausteine des PSYber-Designsystems."
  path="/styleguide"
  noindex
>
  <header class="wrap sg-head dot-grid">
    <Logo href={href('/')} />
    <Kicker class="mt-16">Designsystem</Kicker>
    <h1 class="display h1 mt-4">Styleguide</h1>
    <p class="lead mt-6">
      Schwarz mit violetten Bogen, Acid für alles, was man anklicken kann. Riesige Versalien, kleine
      gesperrte Labels, Mono nur für Code, Pillen statt Kästen. Diese Seite ist nicht verlinkt und
      nicht indexiert.
    </p>
  </header>

  <section class="wrap sg-section" aria-labelledby="sg-farben">
    <Kicker num="0x01">Tokens</Kicker>
    <h2 id="sg-farben" class="display h2 mt-3">
      Farben
    </h2>
    <ul class="sg-swatches mt-10">
      {colors.map((color) => (
        <li class="card sg-swatch">
          <span class:list={['sg-chip', color.swatch]} />
          <span class="mono small text-fg-strong">{color.token}</span>
          <span class="mono meta">{color.hex}</span>
          <span class="meta">{color.use}</span>
        </li>
      ))}
    </ul>
    <h3 class="h4 mt-12">Statusfarben: nie ohne Icon und Text</h3>
    <ul class="mt-4 flex flex-wrap gap-6">
      {status.map((item) => (
        <li class="flex items-center gap-2">
          <Icon name={item.icon} class={item.swatch} />
          <span>{item.name}</span>
          <span class="mono meta">{item.hex}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-typo">
    <Kicker num="0x02">Manrope und Geist Mono</Kicker>
    <h2 id="sg-typo" class="display h2 mt-3">
      Typografie
    </h2>
    <div class="sg-rows mt-10">
      <div class="sg-row">
        <p class="label-up">Display · 650 · Versalien · −0.045em</p>
        <p class="display h1">Ein Klick zu viel?</p>
      </div>
      <div class="sg-row">
        <p class="label-up">H2 · 650 · Versalien · −0.035em</p>
        <p class="display h2">Zwei Einfallstore. Derselbe Schaden.</p>
      </div>
      <div class="sg-row">
        <p class="label-up">H3 · Kartentitel</p>
        <p class="display h3">Layer 8: Menschen stärken</p>
      </div>
      <div class="sg-row">
        <p class="label-up">Titel · 600 · normale Schreibweise</p>
        <p class="title text-fg-strong">Was passiert mit unseren Daten und Passwörtern?</p>
      </div>
      <div class="sg-row">
        <p class="label-up">Lead</p>
        <p class="lead">
          Betrüger hacken keine Router, sondern Menschen. PSYber zeigt Ihrer Familie, wie
          Manipulation funktioniert, und sichert Ihr Heimnetz gleich mit ab.
        </p>
      </div>
      <div class="sg-row">
        <p class="label-up">Fliesstext · 400 · 16–18 px · 1.55</p>
        <p class="measure">
          Ein Anruf der «Polizei», eine Deepfake-Werbung, eine Online-Liebe, die plötzlich Geld
          braucht. Solche Angriffe zielen auf Gefühle, nicht auf Technik. <strong>Fett</strong> und
          ein {/* prettier-ignore */}
          <span><a class="link" href="#sg-typo">Link im Text</a>.</span>
        </p>
      </div>
      <div class="sg-row">
        <p class="label-up">Kicker mit Hex-Nummer · Mono · gesperrt</p>
        <div class="flex flex-wrap items-baseline gap-6">
          <Kicker as="span" num="0x0A">
            So arbeiten wir
          </Kicker>
          <Kicker as="span" raw>
            whoami
          </Kicker>
        </div>
      </div>
      <div class="sg-row">
        <p class="label-up">Grosse Zahl</p>
        <p class="num">15,9 %</p>
      </div>
      <div class="sg-row">
        <p class="label-up">Code · Mono · tabular-nums</p>
        <p class="mono tabular">$ ping familie.local · 12’345 · 15,9 % · CHF 1’250.–</p>
        <p class="sg-note">Nur Beispiele für die Schreibweise von Zahlen, keine echten Werte.</p>
      </div>
    </div>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-marke">
    <Kicker num="0x03">Immer exakt «PSYber»</Kicker>
    <h2 id="sg-marke" class="display h2 mt-3">
      Marke
    </h2>
    <div class="sg-brand mt-10">
      <Card class="sg-brand-cell">
        <p class="label-up">Logo (für dunkle Flächen)</p>
        <Logo class="sg-logo" />
      </Card>
      <Card class="sg-brand-cell">
        <p class="label-up">Wortmarke allein</p>
        <img class="sg-wordmark" src={wordmarkUrl} width="993" height="215" alt="PSYber" />
      </Card>
      <Card class="sg-brand-cell">
        <p class="label-up">Slogan</p>
        <p class="display h3">Betrüger hassen diesen Blick.</p>
      </Card>
      <Card class="sg-brand-cell">
        <p class="label-up">Logo mit Slogan (Druck, Social Media)</p>
        <img
          class="sg-claim"
          src={logoClaimUrl}
          width="1563"
          height="542"
          alt="PSYber. Betrüger hassen diesen Blick."
          loading="lazy"
        />
      </Card>
      <Card class="sg-brand-cell">
        <p class="label-up">«Der Blick»: Die Pupillen folgen dem Zeiger</p>
        <OwlLive class="sg-owl" />
      </Card>
      <div class="sg-brand-cell sg-space on-space">
        <p class="label-up">Eule auf Space</p>
        <Owl
          class="sg-owl"
          label="Die PSYber-Eule: links ein echtes Auge, rechts eines hinter der Lupe"
        />
      </div>
    </div>

    <h3 class="h4 mt-12">Mimik: Blick (Standard), skeptisch, erwischt, genervt</h3>
    <div class="sg-moods mt-4">
      <Owl />
      <Owl mood="skeptisch" />
      <Owl mood="erwischt" />
      <Owl mood="genervt" />
    </div>

    <h3 class="h4 mt-12">Sticker</h3>
    <div class="sg-stickers mt-4">
      <img
        class="sticker"
        src={stickerBlick}
        width="432"
        height="432"
        alt="Sticker: «Betrüger hassen diesen Blick.»"
        loading="lazy"
      />
      <img
        class="sticker"
        src={stickerVersuch}
        width="432"
        height="432"
        alt="Sticker: «Netter Versuch.»"
        loading="lazy"
      />
      <img
        class="sticker"
        src={stickerGeklickt}
        width="432"
        height="432"
        alt="Sticker: «Du hast geklickt.»"
        loading="lazy"
      />
    </div>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-buttons">
    <Kicker num="0x04">Pillen, 52 px</Kicker>
    <h2 id="sg-buttons" class="display h2 mt-3">
      Buttons
    </h2>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <Button href="#sg-buttons" icon>
        Zur Umfrage
      </Button>
      <Button href="#sg-buttons" variant="secondary" icon="arrow-down-right">
        So funktioniert’s
      </Button>
      <Button size="sm">Klein, 44 px</Button>
      <Button disabled>Deaktiviert</Button>
      <a class="btn-text" href="#sg-buttons">
        Textlink mit Pfeil <Icon name="arrow-right" size={18} class="icon-shift" />
      </a>
    </div>
    <div class="sg-space sg-pad on-space mt-8">
      <p class="label-up">Auf Space</p>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button href="#sg-buttons" icon>
          Session anfragen
        </Button>
        <Button href="#sg-buttons" variant="secondary" icon>
          Pakete ansehen
        </Button>
        <a class="link" href="#sg-buttons">
          Link im Text
        </a>
      </div>
    </div>
    <p class="meta mt-6">
      Fokus-Ring: 3 px Acid mit 3 px Abstand. Bitte mit der Tab-Taste durch die Buttons gehen.
    </p>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-karten">
    <Kicker num="0x05">Flächen</Kicker>
    <h2 id="sg-karten" class="display h2 mt-3">
      Karten und Tags
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <Card hover>
        <h3 class="display h3">Sie werden manipuliert.</h3>
        <p class="mt-4">Karte auf Carbon. Hover hebt sie um 2 px und hellt den Rahmen auf.</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          <Tag as="li">Phishing</Tag>
          <Tag as="li">Romance Scam</Tag>
          <Tag as="li" tone="amber">
            Zeitdruck
          </Tag>
        </ul>
      </Card>
      <Card tone="deep">
        <p class="mono small text-fg-muted">$ whoami</p>
        <p class="mono small mt-2">[TODO: Name]</p>
        <p class="mono small text-fg-muted mt-4">$ cat rolle.txt</p>
        <p class="mono small mt-2">Tiefe Karte für Terminal und Code.</p>
      </Card>
      <Card tone="flat">
        <Tag tone="solid">Neu</Tag>
        <h3 class="display h3 mt-4">Flache Karte</h3>
        <p class="mt-4">Nur Rahmen, ohne Fläche. Für Listen und ruhige Bereiche.</p>
      </Card>
    </div>
    <div class="stage sg-pad mt-6">
      <p class="label-up">Bühne</p>
      <p class="display h3 mt-3">Grosses Panel mit Schein</p>
      <p class="mt-4 max-w-xl">
        Für die grossen Auftritte: Klick-Simulator, «Ist das echt?»-Check, Kontakt und Footer.
      </p>
    </div>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-form">
    <Kicker num="0x06">Eingaben</Kicker>
    <h2 id="sg-form" class="display h2 mt-3">
      Formularfelder
    </h2>
    <form class="mt-10 grid max-w-xl gap-6" novalidate>
      <div class="field">
        <label class="label" for="sg-name">
          Name
        </label>
        <input class="input" id="sg-name" type="text" placeholder="Vorname Nachname" />
      </div>
      <div class="field">
        <label class="label" for="sg-mail">
          E-Mail
        </label>
        <input
          class="input"
          id="sg-mail"
          type="email"
          value="keine-adresse"
          aria-invalid="true"
          aria-describedby="sg-mail-error"
        />
        <p class="field-error" id="sg-mail-error">
          <Icon name="circle-alert" size={18} />
          <span>Bitte geben Sie eine gültige E-Mail-Adresse ein.</span>
        </p>
      </div>
      <div class="field">
        <label class="label" for="sg-msg">
          Nachricht <span class="label-hint">(optional)</span>
        </label>
        <textarea class="input" id="sg-msg" placeholder="Was beschäftigt Sie?"></textarea>
      </div>
      <label class="check">
        <input class="checkbox" type="checkbox" />
        <span>Ich habe die Datenschutzerklärung gelesen.</span>
      </label>
    </form>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-icons">
    <Kicker num="0x07">Lucide</Kicker>
    <h2 id="sg-icons" class="display h2 mt-3">
      Icons
    </h2>
    <p class="meta mt-4">Lucide, 1.5 px Strich bei 20 px. Emojis nur in Beispiel-Chats.</p>
    <ul class="sg-icons mt-8">
      {icons.map((name) => (
        <li>
          <Icon name={name} size={20} />
          <span class="mono">{name}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap sg-section" aria-labelledby="sg-motion">
    <Kicker num="0x08">Ruhig und gezielt</Kicker>
    <h2 id="sg-motion" class="display h2 mt-3">
      Motion
    </h2>
    <dl class="sg-motion mt-10">
      <div>
        <dt class="mono">--dur-1</dt>
        <dd>150 ms · Hover, Farbe</dd>
      </div>
      <div>
        <dt class="mono">--dur-2</dt>
        <dd>250 ms · Übergänge, Karten</dd>
      </div>
      <div>
        <dt class="mono">--dur-3</dt>
        <dd>400 ms · Einblenden, Zustände</dd>
      </div>
      <div>
        <dt class="mono">--dur-4</dt>
        <dd>800 ms · Headline-Masken, Treppe</dd>
      </div>
      <div>
        <dt class="mono">--ease</dt>
        <dd>cubic-bezier(0.2, 0.7, 0.2, 1) · in GSAP power3.out</dd>
      </div>
    </dl>
    <p class="meta mt-6">
      Bei «prefers-reduced-motion» steht alles sofort im Endzustand. Der Schalter «Bewegung
      pausieren» hält Dauerbewegung an.
    </p>
  </section>
</Base>

<script>
  import '../scripts/page.ts';
</script>

<style>
  .sg-head {
    padding-block: clamp(2rem, 6vw, 4rem) clamp(3rem, 8vw, 6rem);
  }

  .sg-section {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--hairline);
  }

  .sg-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 1rem;
  }

  .sg-swatch {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem;
  }

  .sg-chip {
    display: block;
    height: 4.5rem;
    margin-bottom: 0.5rem;
    border: 1px solid var(--hairline);
    border-radius: 12px;
  }

  .sg-rows {
    display: grid;
    gap: 2.5rem;
  }

  .sg-row {
    display: grid;
    gap: 0.75rem;
  }

  .sg-note {
    color: var(--ash);
    font-size: var(--fs-small);
  }

  .sg-brand {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
  }

  .sg-brand :global(.sg-brand-cell),
  .sg-brand-cell {
    display: grid;
    align-content: start;
    gap: 1.5rem;
  }

  .sg-brand :global(.sg-logo) {
    --logo-h: 4.5rem;
  }

  .sg-wordmark {
    width: min(100%, 18rem);
    height: auto;
  }

  .sg-claim {
    width: min(100%, 26rem);
    height: auto;
  }

  .sg-brand :global(.sg-owl) {
    width: min(100%, 11rem);
  }

  .sg-moods {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 7rem));
    gap: clamp(1rem, 4vw, 2.5rem);
  }

  .sg-stickers {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 4vw, 2.5rem);
    padding-block: 0.5rem;
  }

  /* Muster einer Space-Fläche */
  .sg-space {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-card);
    background-color: var(--space);
    background-image: radial-gradient(
      30rem 20rem at 88% 0%,
      rgb(var(--nebula-rgb) / 0.42),
      transparent 70%
    );
  }

  .sg-pad {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .sg-icons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: 0.5rem 1rem;
  }

  .sg-icons li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--fg-muted);
    font-size: var(--fs-micro);
  }

  .sg-icons :global(.icon) {
    flex: none;
    color: var(--bone);
  }

  .sg-motion {
    display: grid;
    gap: 0.75rem;
  }

  .sg-motion div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1rem;
  }

  .sg-motion dt {
    color: var(--acid);
    font-size: var(--fs-small);
  }
</style>
