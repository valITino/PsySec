---
/**
 * 0x06 «Ist das echt?»-Check: Text und Ampel-Legende, daneben ein Chat-Mockup in Markenfarben
 * (bewusst kein WhatsApp-Look). Die Nachrichten erscheinen nacheinander mit Tipp-Indikator.
 * Verhalten: src/scripts/chat.ts
 */
import Icon from '@psyber/ui/components/Icon.astro';
import PsiIcon from '@psyber/ui/components/PsiIcon.astro';
import SectionHead from '../SectionHead.astro';

const ampel = [
  { tone: 'ok', icon: 'circle-check', label: 'Grün', text: 'Echt. Alles gut.' },
  {
    tone: 'warn',
    icon: 'triangle-alert',
    label: 'Gelb',
    text: 'Unklar. Nicht reagieren, über den offiziellen Kanal nachfragen.',
  },
  {
    tone: 'crit',
    icon: 'octagon-x',
    label: 'Rot',
    text: 'Betrug. Nicht reagieren; bei Schaden sofort die Bank anrufen und beim BACS melden.',
  },
] as const;
---

<section class="section" aria-labelledby="check-title">
  <div class="wrap check">
    <div class="check-copy">
      <SectionHead
        num="0x06"
        kicker="Ein zweites Bauchgefühl"
        title="Unsicher? Fragen Sie, bevor Sie klicken."
        id="check-title"
      />
      <p class="check-text">
        Im Abo schicken Sie uns verdächtige Nachrichten einfach per WhatsApp. Sie bekommen eine
        klare Einschätzung mit Ampel und dem nächsten Schritt. Betrüger setzen auf Zeitdruck. Wir
        setzen eine Pause dazwischen.
      </p>

      <ul class="ampel" aria-label="Die Ampel">
        {ampel.map((item) => (
          <li class:list={['ampel-item', `ampel-${item.tone}`]}>
            <span class="ampel-icon" aria-hidden="true">
              <Icon name={item.icon} size={22} />
            </span>
            <p>
              <strong>{item.label}:</strong> {item.text}
            </p>
          </li>
        ))}
      </ul>
    </div>

    <div
      class="chat card card-deep"
      data-chat
      role="group"
      aria-label="Beispiel: So läuft ein «Ist das echt?»-Check ab"
    >
      <div class="chat-head">
        <span class="chat-logo" aria-hidden="true">
          <PsiIcon size={18} />
        </span>
        <span class="chat-name">
          <strong>PSYber</strong>
          <span class="mono">«Ist das echt?»-Check</span>
        </span>
      </div>

      <ol class="chat-log">
        <li class="msg msg-out" data-chat-msg>
          <span class="sr-only">Familie: </span>
          <div class="bubble">
            <div class="shot">
              <span class="shot-label mono">Screenshot</span>
              <p>
                ‹Ihre Karte wurde gesperrt. Jetzt entsperren:
                <span class="fake-link">karten-sicherheit-ch.com</span>›
              </p>
            </div>
            <p>Ist das echt? 😬</p>
          </div>
        </li>

        <li class="msg msg-in msg-typing" data-chat-typing aria-hidden="true">
          <div class="bubble">
            <span class="dots">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </div>
        </li>

        <li class="msg msg-in" data-chat-msg>
          <span class="sr-only">PSYber: </span>
          <div class="bubble">
            <p>
              🔴 <strong>Rot: Betrug.</strong> Nicht klicken und nicht antworten. Ihre Bank
              verschickt keine solchen Links. Nachricht löschen und Absender blockieren.
            </p>
          </div>
        </li>

        <li class="msg msg-out" data-chat-msg>
          <span class="sr-only">Familie: </span>
          <div class="bubble">
            <p>Danke!! 🙏</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .check {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .check-copy {
    display: grid;
    align-content: start;
    gap: 1.75rem;
  }

  .check-text {
    max-width: 34em;
  }

  .ampel {
    display: grid;
    gap: 0.875rem;
    margin-top: 0.5rem;
  }

  .ampel-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.875rem;
  }

  .ampel-item p {
    max-width: 30em;
  }

  .ampel-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  /* Statusfarben nur am Icon; der Text daneben bleibt in der Textfarbe */
  .ampel-ok .ampel-icon {
    color: var(--ok);
  }

  .ampel-warn .ampel-icon {
    color: var(--warn);
  }

  .ampel-crit .ampel-icon {
    color: var(--crit);
  }

  /* ---------- Chat-Mockup ---------- */

  .chat {
    display: grid;
    align-content: start;
    gap: 0;
    width: min(100%, 26rem);
    justify-self: center;
    overflow: hidden;
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background-color: var(--aubergine);
  }

  .chat-logo {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: var(--night);
    color: var(--lav);
  }

  .chat-name {
    display: grid;
    line-height: 1.3;
  }

  .chat-name strong {
    font-weight: 900;
    --casl: 1;
  }

  .chat-name .mono {
    color: var(--lav);
    font-size: var(--fs-micro);
  }

  .chat-log {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-height: 22rem;
    padding: 1.25rem;
  }

  .msg {
    display: flex;
  }

  .msg-out {
    justify-content: flex-end;
  }

  .bubble {
    display: grid;
    gap: 0.5rem;
    max-width: 86%;
    padding: 0.75rem 0.9375rem;
    border-radius: 1.125rem;
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  .msg-out .bubble {
    border-bottom-right-radius: 0.3rem;
    background-color: var(--violet);
    color: var(--white);
  }

  .msg-in .bubble {
    border-bottom-left-radius: 0.3rem;
    background-color: var(--aubergine);
    color: var(--white);
  }

  /* Bild-Platzhalter: der weitergeleitete Screenshot */
  .shot {
    display: grid;
    gap: 0.375rem;
    padding: 0.625rem 0.75rem;
    border: 1px dashed color-mix(in srgb, var(--white) 55%, transparent);
    border-radius: 0.625rem;
    background-color: color-mix(in srgb, var(--night) 55%, transparent);
    font-size: var(--fs-meta);
  }

  .shot-label {
    color: var(--soft);
    font-size: 0.6875rem;
  }

  .shot .fake-link {
    color: var(--soft);
  }

  .dots {
    display: inline-flex;
    gap: 0.3rem;
    padding-block: 0.375rem;
  }

  .dots span {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background-color: var(--lav);
    animation: chat-dot 1.1s ease-in-out infinite;
  }

  .dots span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .dots span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes chat-dot {
    0%,
    60%,
    100% {
      opacity: 0.35;
      transform: none;
    }

    30% {
      opacity: 1;
      transform: translateY(-0.2rem);
    }
  }

  /*
   * Ablauf: chat.ts setzt `data-animated` und blendet die Nachrichten nacheinander ein (.is-in).
   * Ohne dieses Attribut sind alle Nachrichten sichtbar und der Tipp-Indikator ist ausgeblendet.
   */
  .msg-typing {
    display: none;
  }

  .chat[data-animated] .msg {
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .chat[data-animated] .msg:not(.is-in) {
    opacity: 0;
    transform: translateY(0.75rem);
  }

  .chat[data-animated] .msg-typing.is-in {
    display: flex;
  }

  @media (min-width: 64rem) {
    .check {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }

    .chat {
      justify-self: end;
    }
  }
</style>
