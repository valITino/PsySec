---
/**
 * 0x01 Problem-Split: zwei Einfallstore, darunter das Zahlenband.
 * Zahlen nur aus Abschnitt 5.17 des Auftrags, jeweils mit Quellenlink.
 */
import Card from '@psyber/ui/components/Card.astro';
import Icon from '@psyber/ui/components/Icon.astro';
import Tag from '@psyber/ui/components/Tag.astro';
import { sources } from '../../config/site.ts';
import SectionHead from '../SectionHead.astro';

const cards = [
  {
    layer: 'Layer 8 · Mensch',
    icon: 'brain',
    title: 'Sie werden manipuliert.',
    text: 'Ein Anruf der ‹Polizei›, eine Deepfake-Werbung, eine Online-Liebe, die plötzlich Geld braucht. Solche Angriffe zielen auf Gefühle, nicht auf Technik.',
    tags: ['Online-Anlagebetrug', 'Phishing', 'Romance Scam', 'Cybermobbing', 'OpSec'],
  },
  {
    layer: 'Layer 1–7 · Technik',
    icon: 'router',
    title: 'Ihr Netz steht offen.',
    text: 'Standard-Passwort am Router, Kindergeräte ohne Schutz, kein Backup, und niemand weiss, welche Geräte eigentlich im WLAN hängen. Lücken, die im Alltag niemand bemerkt.',
    tags: ['Heimnetz', 'Netzwerkverkehr', 'Kinderschutz', 'Passwörter', 'Backup'],
  },
] as const;

const stats = [
  {
    display: '15,9 %',
    to: 15.9,
    decimals: 1,
    suffix: ' %',
    text: 'der Befragten wurden innert 12 Monaten Opfer von Betrug. 2022 waren es 8,4 %.',
    source: sources.crimeSurvey,
  },
  {
    display: '4,8×',
    to: 4.8,
    decimals: 1,
    suffix: '×',
    text: 'so viele Meldungen zu Werbung für Online-Anlagebetrug wie ein Jahr zuvor (1. Halbjahr 2025).',
    source: { ...sources.bacsHalbjahr, label: 'BACS' },
  },
  {
    display: '26 %',
    to: 26,
    decimals: 0,
    suffix: ' %',
    text: 'der Meldungen ans BACS betrafen 2025 Anrufe im Namen falscher Behörden.',
    source: sources.bacsJahr,
  },
];
---

<section class="section" aria-labelledby="problem-title">
  <div class="wrap">
    <SectionHead
      num="0x01"
      kicker="Wo Familien angreifbar sind"
      title="Zwei Einfallstore. Derselbe Schaden."
      id="problem-title"
    />

    <div class="split">
      {cards.map((card) => (
        <Card as="article" hover class="split-card">
          <p class="split-layer mono">
            <Icon name={card.icon} size={18} />
            {card.layer}
          </p>
          <h3 class="h3 split-title">{card.title}</h3>
          <p class="split-text">{card.text}</p>
          <ul class="split-tags" aria-label="Themen">
            {card.tags.map((tag) => (
              <Tag as="li">{tag}</Tag>
            ))}
          </ul>
        </Card>
      ))}
    </div>

    <ul class="stats">
      {stats.map((stat) => (
        <li class="stat">
          <p class="stat-body">
            <span class="num stat-num">
              <span class="sr-only">{stat.display}</span>
              <span
                aria-hidden="true"
                data-count={stat.to}
                data-decimals={stat.decimals}
                data-suffix={stat.suffix}
              >
                {stat.display}
              </span>
            </span>
            <span class="stat-text">{stat.text}</span>
          </p>
          <p class="stat-source mono">
            <span aria-hidden="true">// </span>Quelle:{' '}
            <a class="link" href={stat.source.url} target="_blank" rel="noopener">
              {stat.source.label}
              <span class="sr-only"> (externer Link)</span>
            </a>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .split {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .split :global(.split-card) {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .split-layer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--lav);
    font-size: var(--fs-meta);
  }

  .split-text {
    max-width: 34em;
  }

  .split-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .stats {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .stat {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .stat-body {
    display: grid;
    gap: 1rem;
  }

  .stat-num {
    display: block;
    white-space: nowrap;
  }

  .stat-text {
    max-width: 22em;
  }

  .stat-source {
    color: var(--lav);
    font-size: var(--fs-micro);
  }

  .stat-source .link {
    color: var(--lav);
  }

  @media (min-width: 48rem) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.5rem, 4vw, 3.5rem);
    }

    .stat + .stat {
      padding-left: clamp(1.5rem, 4vw, 3.5rem);
      border-left: 1px solid var(--line);
    }
  }
</style>
