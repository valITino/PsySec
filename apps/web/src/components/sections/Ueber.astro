---
/**
 * 0x09 Über: Porträt in der Punktraster-Karte, daneben Überschrift und Terminal-Karte.
 * Das Foto ist freigestellt (durchsichtiger Grund) und steht auf der unteren Kante der Karte.
 * Keine erfundenen Angaben.
 */
import stickerUrl from '@psyber/ui/brand/sticker-blick.svg?url';
import portraitAvif from '../../assets/portrait.avif?url';
import portraitWebp from '../../assets/portrait.webp?url';
import { about } from '../../config/site.ts';
import SectionHead from '../SectionHead.astro';

const lines = [
  { command: 'whoami', output: about.name },
  { command: 'cat rolle.txt', output: about.rolle },
  { command: 'cat ausbildung.txt', output: about.ausbildung },
  { command: 'cat warum.txt', output: about.warum },
];
---

<section data-lazy class="sheet" id="ueber" aria-labelledby="ueber-title">
  <div class="wrap about">
    <div class="portrait" data-enter>
      <figure class="portrait-frame">
        <span class="portrait-corner portrait-corner-tl" aria-hidden="true"></span>
        <span class="portrait-corner portrait-corner-tr" aria-hidden="true"></span>
        <span class="portrait-corner portrait-corner-bl" aria-hidden="true"></span>
        <span class="portrait-corner portrait-corner-br" aria-hidden="true"></span>
        <picture>
          <source type="image/avif" srcset={portraitAvif} />
          <img
            class="portrait-photo"
            src={portraitWebp}
            width={about.foto.width}
            height={about.foto.height}
            alt={about.foto.alt}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="portrait-caption">
          <span class="label-up">{about.name}</span>
          <span>{about.rolle}</span>
        </figcaption>
      </figure>
      <img
        class="sticker portrait-sticker"
        src={stickerUrl}
        width="432"
        height="432"
        alt="Sticker mit der PSYber-Eule: «Betrüger hassen diesen Blick.»"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about-main">
      <SectionHead
        num="0x09"
        kicker="whoami"
        kickerRaw
        title="Wer hinter PSYber steckt."
        id="ueber-title"
      />

      <div class="terminal" data-enter>
        <div class="terminal-bar" aria-hidden="true">
          <span class="terminal-dots">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="mono terminal-title">psyber@layer8: ~</span>
        </div>
        <dl class="terminal-body mono">
          {lines.map((line) => (
            <div>
              <dt>
                <span class="prompt" aria-hidden="true">
                  $
                </span>
                {line.command}
              </dt>
              <dd>{line.output}</dd>
            </div>
          ))}
          <div aria-hidden="true">
            <dt>
              <span class="prompt">$</span>
              <span class="terminal-cursor"></span>
            </dt>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .about-main {
    display: grid;
    align-content: center;
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* ---------- Porträt ---------- */

  .portrait-frame {
    position: relative;
    display: grid;
    align-content: end;
    justify-items: center;
    /* Die Figur steht auf der unteren Kante und folgt dort der Rundung der Karte. */
    overflow: hidden;
    min-height: clamp(20rem, 60vw, 38rem);
    height: 100%;
    /* oben Platz für die Bildunterschrift, damit sie nie über dem Gesicht liegt */
    padding-top: 5.5rem;
    border: 1px solid var(--hairline);
    border-radius: var(--r-panel);
    background-color: var(--carbon);
    background-image:
      radial-gradient(60% 50% at 50% 46%, rgb(var(--space-rgb) / 0.55), transparent 100%),
      radial-gradient(rgb(var(--bone-rgb) / 0.14) 1px, transparent 1.5px);
    background-size:
      100% 100%,
      14px 14px;
  }

  .portrait {
    --sticker-size: clamp(6.5rem, 4rem + 9vw, 10.5rem);
    position: relative;
  }

  /* Das Bild selbst ist das Rasterelement: So steht es mittig und misst sich an der Karte. */
  .portrait-frame picture {
    display: contents;
  }

  /* Nie grösser als die Datei hergibt (579 px breit): Darüber würde das Bild unscharf. */
  .portrait-photo {
    width: min(94%, 36rem);
    height: auto;
  }

  .portrait-caption {
    position: absolute;
    top: 2rem;
    left: 2.25rem;
    display: grid;
    justify-items: start;
    gap: 0.25rem;
    color: var(--ash);
    font-size: var(--fs-small);
  }

  .portrait-caption .label-up {
    color: var(--bone);
  }

  /* Der Sticker klebt über der unteren Kante der Karte: gut die Hälfte drauf, der Rest hängt über */
  .portrait-sticker {
    --sticker-tilt: 11deg;
    position: absolute;
    right: calc(var(--sticker-size) * -0.1);
    bottom: calc(var(--sticker-size) * -0.4);
  }

  /* Die Ecken liegen wie ein Sucher über dem Bild. */
  .portrait-corner {
    position: absolute;
    z-index: 1;
    width: 1.125rem;
    height: 1.125rem;
    border: 1px solid var(--ash);
  }

  .portrait-corner-tl {
    top: 1.25rem;
    left: 1.25rem;
    border-right: 0;
    border-bottom: 0;
  }

  .portrait-corner-tr {
    top: 1.25rem;
    right: 1.25rem;
    border-bottom: 0;
    border-left: 0;
  }

  .portrait-corner-bl {
    bottom: 1.25rem;
    left: 1.25rem;
    border-top: 0;
    border-right: 0;
  }

  .portrait-corner-br {
    right: 1.25rem;
    bottom: 1.25rem;
    border-top: 0;
    border-left: 0;
  }

  /* ---------- Terminal ---------- */

  .terminal {
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
    background-color: var(--pit);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--hairline);
    background-color: var(--carbon);
  }

  .terminal-dots {
    display: flex;
    gap: 0.375rem;
  }

  .terminal-dots span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: var(--hairline);
  }

  .terminal-title {
    color: var(--ash);
    font-size: var(--fs-micro);
  }

  .terminal-body {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .terminal-body dt {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ash);
  }

  .prompt {
    color: var(--acid);
  }

  .terminal-body dd {
    margin-top: 0.25rem;
    padding-left: 1.25rem;
    color: var(--bone);
    overflow-wrap: anywhere;
  }

  .terminal-cursor {
    width: 0.6em;
    height: 1.15em;
    background-color: var(--acid);
    animation: cursor-blink 1.1s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  /*
   * Auftritt, sobald die Sektion ins Bild kommt (reveal.ts setzt data-enter): Der Sucher stellt
   * scharf (die Ecken rücken von aussen an ihren Platz), eine feine Linie tastet das Bild einmal
   * ab, der Sticker klebt sich auf; im Terminal erscheinen die Zeilen nacheinander.
   */
  .portrait-frame::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: linear-gradient(
      to bottom,
      rgb(var(--acid-rgb) / 0) 0,
      rgb(var(--acid-rgb) / 0.85) 50%,
      rgb(var(--acid-rgb) / 0) 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 0.375rem;
    content: '';
    opacity: 0;
    pointer-events: none;
  }

  .portrait[data-enter='wait'] .portrait-photo,
  .portrait[data-enter='wait'] .portrait-corner,
  .portrait[data-enter='wait'] .portrait-caption,
  .portrait[data-enter='wait'] .portrait-sticker,
  .terminal[data-enter='wait'] .terminal-body > div {
    opacity: 0;
  }

  .portrait[data-enter='in'] .portrait-photo {
    animation: about-rise 700ms var(--ease) backwards;
  }

  .portrait[data-enter='in'] .portrait-caption {
    animation: about-rise 500ms var(--ease) 260ms backwards;
  }

  .portrait[data-enter='in'] .portrait-corner {
    animation: about-focus 560ms cubic-bezier(0.2, 1.5, 0.4, 1) 140ms backwards;
  }

  .portrait[data-enter='in'] .portrait-corner-tl {
    --from: -0.875rem -0.875rem;
  }

  .portrait[data-enter='in'] .portrait-corner-tr {
    --from: 0.875rem -0.875rem;
  }

  .portrait[data-enter='in'] .portrait-corner-bl {
    --from: -0.875rem 0.875rem;
  }

  .portrait[data-enter='in'] .portrait-corner-br {
    --from: 0.875rem 0.875rem;
  }

  .portrait[data-enter='in'] .portrait-frame::after {
    animation: about-scan 950ms cubic-bezier(0.3, 0, 0.3, 1) 320ms;
  }

  .portrait[data-enter='in'] .portrait-sticker {
    animation: about-stick 420ms cubic-bezier(0.2, 1.5, 0.4, 1) 780ms backwards;
  }

  .terminal[data-enter='in'] .terminal-body > div {
    animation: about-line 320ms var(--ease) backwards;
  }

  .terminal[data-enter='in'] .terminal-body > div:nth-child(2) {
    animation-delay: 160ms;
  }

  .terminal[data-enter='in'] .terminal-body > div:nth-child(3) {
    animation-delay: 320ms;
  }

  .terminal[data-enter='in'] .terminal-body > div:nth-child(4) {
    animation-delay: 480ms;
  }

  .terminal[data-enter='in'] .terminal-body > div:nth-child(5) {
    animation-delay: 640ms;
  }

  @keyframes about-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes about-focus {
    from {
      opacity: 0;
      translate: var(--from);
    }
  }

  @keyframes about-scan {
    0% {
      background-position: 0 0;
      opacity: 1;
    }

    85% {
      opacity: 1;
    }

    100% {
      background-position: 0 100%;
      opacity: 0;
    }
  }

  @keyframes about-stick {
    from {
      opacity: 0;
      scale: 1.5;
    }
  }

  @keyframes about-line {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
  }

  /* Im Druck und bei angehaltener Bewegung wartet nichts auf seinen Auftritt. */
  @media print {
    .portrait[data-enter] *,
    .terminal[data-enter] * {
      opacity: 1;
    }
  }

  :global(html[data-motion='off']) .portrait[data-enter] *,
  :global(html[data-motion='off']) .terminal[data-enter] * {
    opacity: 1;
    animation: none;
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: stretch;
    }
  }
</style>
