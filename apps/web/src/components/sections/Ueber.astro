---
/**
 * 0x09 Über: Terminal-Karte und Foto-Platzhalter. Keine erfundenen Angaben.
 */
import PsiIcon from '@psyber/ui/components/PsiIcon.astro';
import { about } from '../../config/site.ts';
import SectionHead from '../SectionHead.astro';

const lines = [
  { command: 'whoami', output: about.name },
  { command: 'cat rolle.txt', output: about.rolle },
  { command: 'cat warum.txt', output: about.warum },
];
---

<section class="section" id="ueber" aria-labelledby="ueber-title">
  <div class="wrap">
    <SectionHead num="0x09" kicker="whoami" title="Wer hinter PSYber steckt." id="ueber-title" />

    <div class="about">
      <div class="terminal card card-deep">
        <div class="terminal-bar" aria-hidden="true">
          <span class="terminal-dots">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="mono terminal-title">psyber@layer8: ~</span>
        </div>
        <dl class="terminal-body mono">
          {lines.map((line) => (
            <div>
              <dt>
                <span class="prompt" aria-hidden="true">
                  $
                </span>
                {line.command}
              </dt>
              <dd>{line.output}</dd>
            </div>
          ))}
          <div aria-hidden="true">
            <dt>
              <span class="prompt">$</span>
              <span class="terminal-cursor"></span>
            </dt>
          </div>
        </dl>
      </div>

      <figure class="portrait">
        <div class="portrait-frame">
          <span class="portrait-corner portrait-corner-tl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-tr" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-bl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-br" aria-hidden="true"></span>
          <PsiIcon size={72} class="portrait-psi" />
          <figcaption class="mono">{about.foto}</figcaption>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .terminal {
    overflow: hidden;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
    background-color: var(--aubergine);
  }

  .terminal-dots {
    display: flex;
    gap: 0.375rem;
  }

  .terminal-dots span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: var(--line);
  }

  .terminal-title {
    color: var(--lav);
    font-size: var(--fs-micro);
  }

  .terminal-body {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .terminal-body dt {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--lav);
  }

  .prompt {
    color: var(--amber);
  }

  .terminal-body dd {
    margin-top: 0.25rem;
    padding-left: 1.25rem;
    color: var(--white);
    overflow-wrap: anywhere;
  }

  .terminal-cursor {
    width: 0.6em;
    height: 1.15em;
    background-color: var(--lav);
  }

  .portrait-frame {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1.25rem;
    min-height: 16rem;
    height: 100%;
    padding: 2rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-card);
    color: var(--lav);
  }

  .portrait-frame :global(.portrait-psi) {
    color: var(--lav);
  }

  .portrait figcaption {
    color: var(--soft);
    font-size: var(--fs-small);
  }

  .portrait-corner {
    position: absolute;
    width: 1.125rem;
    height: 1.125rem;
    border: 2px solid var(--lav);
  }

  .portrait-corner-tl {
    top: 0.875rem;
    left: 0.875rem;
    border-right: 0;
    border-bottom: 0;
  }

  .portrait-corner-tr {
    top: 0.875rem;
    right: 0.875rem;
    border-bottom: 0;
    border-left: 0;
  }

  .portrait-corner-bl {
    bottom: 0.875rem;
    left: 0.875rem;
    border-top: 0;
    border-right: 0;
  }

  .portrait-corner-br {
    right: 0.875rem;
    bottom: 0.875rem;
    border-top: 0;
    border-left: 0;
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
