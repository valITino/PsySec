---
/**
 * 0x07 Ablauf: vier nummerierte Schritte und der «PSYber-Handshake» als kleines Sequenzdiagramm.
 */
import Icon from '@psyber/ui/components/Icon.astro';
import SectionHead from '../SectionHead.astro';

const steps = [
  {
    title: 'Kennenlernen',
    text: 'Ein kurzes Gespräch: Wer gehört zur Familie, welche Geräte gibt es, was beschäftigt Sie?',
  },
  {
    title: 'Session zu Hause',
    text: 'Wir erklären die Maschen am Beispiel Ihres Alltags. Ohne Fachchinesisch, mit Humor.',
  },
  {
    title: 'Absichern',
    text: 'Router, Kindergeräte, Passwörter und Backup: Wir richten alles gemeinsam ein und dokumentieren es.',
  },
  {
    title: 'Dranbleiben',
    text: 'Mit dem Abo bleiben wir erreichbar, prüfen verdächtige Nachrichten und melden uns bei neuen Maschen.',
  },
];

/** `to`: Richtung des Pfeils im Diagramm */
const handshake = [
  { flag: 'SYN', to: 'psyber', text: 'Sie melden sich. PSYber ruft nie unaufgefordert an.' },
  {
    flag: 'SYN-ACK',
    to: 'familie',
    text: 'Wir rufen auf Ihre hinterlegte Nummer zurück, mit Codewort.',
  },
  {
    flag: 'ACK',
    to: 'psyber',
    text: 'Sie starten die Fernwartung im Programm, das wir beim Hausbesuch eingerichtet haben.',
  },
  { flag: 'FIN', to: 'familie', text: 'Sitzung beendet, kurzes Protokoll per Mail.' },
] as const;
---

<section class="section" id="ablauf" aria-labelledby="ablauf-title">
  <div class="wrap">
    <SectionHead
      num="0x07"
      kicker="So arbeiten wir"
      title="Erst verstehen. Dann absichern."
      id="ablauf-title"
    />

    <ol class="process">
      {steps.map((step, index) => (
        <li class="process-step">
          <span class="process-num mono" aria-hidden="true">
            0{index + 1}
          </span>
          <h3 class="h3 process-title">{step.title}</h3>
          <p class="process-text">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="handshake card card-deep">
      <div class="handshake-intro">
        <p class="kicker">
          <span aria-hidden="true">// </span>Angelehnt an TCP
        </p>
        <h3 class="h3">Der PSYber-Handshake</h3>
        <p class="handshake-foot">
          <Icon name="shield-alert" size={20} />
          <span>Wer anruft und sofort Fernzugriff verlangt, ist nie PSYber.</span>
        </p>
      </div>

      <div class="sequence">
        <p class="sequence-heads mono" aria-hidden="true">
          <span>Familie</span>
          <span>PSYber</span>
        </p>
        <ol class="sequence-steps">
          {handshake.map((step) => (
            <li class:list={['seq', `seq-to-${step.to}`]}>
              <span class="sr-only">
                {step.to === 'psyber' ? 'Familie an PSYber' : 'PSYber an Familie'}:{' '}
              </span>
              <span class="seq-arrow" aria-hidden="true">
                <span class="seq-flag mono">{step.flag}</span>
              </span>
              <span class="sr-only">{step.flag}. </span>
              <span class="seq-text">{step.text}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Vier Schritte ---------- */

  .process {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .process-step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  /* Knoten auf der Linie: Anklang ans Psi-Netz */
  .process-step::before {
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--lav);
    content: '';
  }

  .process-num {
    color: var(--lav);
    font-size: var(--fs-meta);
  }

  .process-text {
    max-width: 26em;
  }

  /* ---------- Handshake ---------- */

  .handshake {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding: clamp(1.5rem, 1rem + 2.4vw, 3rem);
  }

  .handshake-intro {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .handshake-foot {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-top: 0.5rem;
    padding: 0.875rem 1rem;
    border: 1px solid color-mix(in srgb, var(--amber) 55%, transparent);
    border-radius: 12px;
    color: var(--white);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.45;
  }

  .handshake-foot :global(.icon) {
    flex: none;
    margin-top: 0.1em;
    color: var(--amber);
  }

  .sequence {
    --lane: 0.75rem;
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .sequence-heads {
    display: flex;
    justify-content: space-between;
    color: var(--white);
    font-size: var(--fs-meta);
    font-weight: 600;
  }

  .sequence-steps {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding-block: 0.75rem 1rem;
  }

  /* Lebenslinien von Familie (links) und PSYber (rechts) */
  .sequence-steps::before,
  .sequence-steps::after {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px dashed var(--border-strong);
    content: '';
  }

  .sequence-steps::before {
    left: var(--lane);
  }

  .sequence-steps::after {
    right: var(--lane);
  }

  .seq {
    display: grid;
    gap: 0.5rem;
    padding-inline: var(--lane);
  }

  .seq-arrow {
    position: relative;
    display: block;
    height: 1.75rem;
    border-bottom: 2px solid var(--lav);
  }

  /* Pfeilspitze */
  .seq-arrow::after {
    position: absolute;
    bottom: -6px;
    width: 10px;
    height: 10px;
    border-top: 2px solid var(--lav);
    border-right: 2px solid var(--lav);
    content: '';
  }

  .seq-to-psyber .seq-arrow::after {
    right: 1px;
    transform: rotate(45deg);
  }

  .seq-to-familie .seq-arrow::after {
    left: 1px;
    transform: rotate(-135deg);
  }

  .seq-flag {
    position: absolute;
    bottom: 0.375rem;
    left: 50%;
    padding: 0.0625rem 0.5rem;
    border-radius: 6px;
    background-color: var(--aubergine);
    color: var(--white);
    font-size: var(--fs-micro);
    font-weight: 700;
    transform: translateX(-50%);
  }

  .seq-text {
    padding-inline: 0.875rem;
    color: var(--soft);
    font-size: var(--fs-small);
    line-height: 1.5;
    text-align: center;
    text-wrap: balance;
  }

  @media (min-width: 40rem) {
    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .process {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .process-step {
      padding-right: 1.5rem;
    }

    .handshake {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3rem;
      align-items: center;
    }
  }
</style>
