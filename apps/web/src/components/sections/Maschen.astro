---
/**
 * 0x04 Maschen: Fallakten aus der Content Collection `maschen`.
 * Eine hervorgehobene Fallakte mit Mockup, darunter eine nummerierte, aufklappbare Liste.
 */
import Icon from '@psyber/ui/components/Icon.astro';
import Tag from '@psyber/ui/components/Tag.astro';
import { getCollection } from 'astro:content';
import SectionHead from '../SectionHead.astro';

const all = (await getCollection('maschen')).sort(
  (left, right) =>
    Number(right.data.featured) - Number(left.data.featured) ||
    right.data.datum.getTime() - left.data.datum.getTime() ||
    left.id.localeCompare(right.id),
);
const featured = all.find((entry) => entry.data.featured) ?? all[0];
const rest = all.filter((entry) => entry !== featured);
---

<section data-lazy class="sheet maschen" id="maschen" aria-labelledby="maschen-title">
  <div class="wrap">
    <SectionHead
      num="0x04"
      kicker="Fallakten"
      title="Maschen, die gerade kursieren."
      id="maschen-title"
      size="xl"
    />

    {featured && (
      <article class="case">
        <div class="case-body">
          <p class="case-meta">
            <Tag tone="solid">Neu</Tag>
            <span class="label-up">Fallakte 00</span>
          </p>
          <h3 class="display case-title">{featured.data.titel}</h3>
          <blockquote class="case-quote">«{featured.data.zitat}»</blockquote>
          <ul class="case-tags" aria-label="Hebel">
            {featured.data.hebel.map((hebel) => (
              <Tag as="li" tone="amber">
                {hebel}
              </Tag>
            ))}
          </ul>
          <dl class="case-facts">
            <div>
              <dt>
                <Icon name="triangle-alert" size={18} />
                Warnsignal
              </dt>
              <dd>{featured.data.warnsignal}</dd>
            </div>
            <div>
              <dt>
                <Icon name="shield-check" size={18} />
                Was hilft
              </dt>
              <dd>{featured.data.hilft}</dd>
            </div>
          </dl>
          <p class="kicker case-source">
            <span aria-hidden="true">// </span>Quelle:{' '}
            <a class="link" href={featured.data.quelle.url} target="_blank" rel="noopener">
              {featured.data.quelle.name}
              <span class="sr-only"> (externer Link)</span>
            </a>
          </p>
        </div>

        <!-- Generisches Mockup einer Social-Media-Anzeige: keine echte Person, keine echte Marke -->
        <div class="case-visual" aria-hidden="true">
          <div class="ad">
            <div class="ad-head">
              <span class="ad-avatar" />
              <span class="ad-lines">
                <span />
                <span />
              </span>
              <span class="ad-sponsored mono">Gesponsert</span>
            </div>
            <div class="ad-media">
              <span class="ad-face" />
              <span class="ad-shoulders" />
              <svg class="ad-chart" viewBox="0 0 200 80" preserveAspectRatio="none">
                <polyline points="0,70 30,62 55,66 85,44 110,50 140,26 165,30 200,6" />
              </svg>
              <span class="ad-scan">
                <span class="mono">Echt?</span>
              </span>
              <span class="ad-corner ad-corner-tl" />
              <span class="ad-corner ad-corner-tr" />
              <span class="ad-corner ad-corner-bl" />
              <span class="ad-corner ad-corner-br" />
            </div>
            <div class="ad-foot">
              <span class="ad-cta">Jetzt starten</span>
              <span class="ad-lines">
                <span />
              </span>
            </div>
          </div>
        </div>
      </article>
    )}

    <ol class="files">
      {rest.map((entry, index) => (
        <li>
          <details class="file">
            <summary>
              <span class="file-num mono" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="file-main">
                <span class="file-title">{entry.data.titel}</span>
                <span class="file-quote">«{entry.data.zitat}»</span>
              </span>
              <span class="file-tags">
                {entry.data.hebel.map((hebel) => (
                  <Tag tone="amber">{hebel}</Tag>
                ))}
              </span>
              <span class="orb file-toggle" aria-hidden="true">
                <Icon name="plus" size={20} />
              </span>
            </summary>
            <div class="file-body">
              <dl class="case-facts">
                <div>
                  <dt>
                    <Icon name="triangle-alert" size={18} />
                    Warnsignal
                  </dt>
                  <dd>{entry.data.warnsignal}</dd>
                </div>
                <div>
                  <dt>
                    <Icon name="shield-check" size={18} />
                    Was hilft
                  </dt>
                  <dd>{entry.data.hilft}</dd>
                </div>
              </dl>
              <p class="kicker case-source">
                <span aria-hidden="true">// </span>Quelle:{' '}
                <a class="link" href={entry.data.quelle.url} target="_blank" rel="noopener">
                  {entry.data.quelle.name}
                  <span class="sr-only"> (externer Link)</span>
                </a>
              </p>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* ---------- Hervorgehobene Fallakte: Karte mit Acid-Kante ---------- */

  .case {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
    padding: clamp(1.5rem, 1rem + 2.4vw, 3rem);
    border: 1px solid color-mix(in srgb, var(--acid) 55%, transparent);
    border-radius: var(--r-panel);
    background-color: var(--carbon);
    background-image: radial-gradient(
      30rem 20rem at 0% 0%,
      rgb(var(--acid-rgb) / 0.06),
      transparent 70%
    );
  }

  .case-body {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .case-meta {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .case-title {
    max-width: 11em;
    font-size: clamp(2rem, 1.1rem + 3.4vw, 4rem);
  }

  .case-quote {
    max-width: 28em;
    color: var(--bone);
    font-size: var(--fs-lead);
    letter-spacing: -0.015em;
    line-height: 1.36;
  }

  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .case-facts {
    display: grid;
    gap: 1.25rem;
  }

  .case-facts dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
    color: var(--ash);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }

  .case-facts dt :global(.icon) {
    color: var(--acid);
  }

  .case-facts div:first-child dt :global(.icon) {
    color: var(--amber);
  }

  .case-facts dd {
    max-width: 30em;
  }

  .case-source .link {
    color: var(--bone);
  }

  .case .case-facts {
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  /* ---------- Mockup ---------- */

  .case-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 18rem;
    padding: clamp(1rem, 4vw, 2rem);
    border-radius: var(--r-card);
    background-color: var(--pit);
    background-image: radial-gradient(rgb(244 244 239 / 0.1) 1px, transparent 1.5px);
    background-size: 20px 20px;
  }

  .ad {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 19rem);
    padding: 0.875rem;
    border: 1px solid var(--hairline);
    border-radius: 16px;
    background-color: var(--carbon);
  }

  .ad-head,
  .ad-foot {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .ad-avatar {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 38%, var(--nebula) 0 28%, var(--space) 30% 100%);
    filter: blur(3px);
  }

  .ad-lines {
    display: grid;
    flex: 1;
    gap: 0.375rem;
  }

  .ad-lines span {
    height: 0.5rem;
    border-radius: 4px;
    background-color: var(--hairline);
  }

  .ad-lines span:first-child {
    width: 62%;
  }

  .ad-lines span:nth-child(2) {
    width: 38%;
  }

  .ad-sponsored {
    color: var(--ash);
    font-size: 0.6875rem;
  }

  .ad-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 10px;
    background: linear-gradient(160deg, var(--space), var(--space-deep));
  }

  /* Unscharfe Silhouette: bewusst ohne erkennbares Gesicht */
  .ad-face,
  .ad-shoulders {
    position: absolute;
    left: 50%;
    background-color: var(--nebula);
    filter: blur(9px);
    opacity: 0.75;
    transform: translateX(-50%);
  }

  .ad-face {
    top: 16%;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .ad-shoulders {
    bottom: -18%;
    width: 62%;
    height: 48%;
    border-radius: 50% 50% 0 0;
  }

  .ad-chart {
    position: absolute;
    inset: 18% 6% 10% 6%;
    width: 88%;
    height: 72%;
    fill: none;
    opacity: 0.9;
    stroke: var(--bone);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .ad-chart polyline {
    vector-effect: non-scaling-stroke;
  }

  /* Scan-Linie: prüft, ob das Bild echt ist */
  .ad-scan {
    position: absolute;
    top: 44%;
    right: 0;
    left: 0;
    height: 2px;
    background-color: var(--amber);
    transition: top var(--dur-4) var(--ease);
  }

  .ad-scan span {
    position: absolute;
    right: 0.5rem;
    bottom: 0.375rem;
    padding: 0.125rem 0.4rem;
    border-radius: 4px;
    background-color: var(--amber);
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .ad-corner {
    position: absolute;
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--amber);
  }

  .ad-corner-tl {
    top: 0.5rem;
    left: 0.5rem;
    border-right: 0;
    border-bottom: 0;
  }

  .ad-corner-tr {
    top: 0.5rem;
    right: 0.5rem;
    border-bottom: 0;
    border-left: 0;
  }

  .ad-corner-bl {
    bottom: 0.5rem;
    left: 0.5rem;
    border-top: 0;
    border-right: 0;
  }

  .ad-corner-br {
    right: 0.5rem;
    bottom: 0.5rem;
    border-top: 0;
    border-left: 0;
  }

  .ad-cta {
    flex: none;
    padding: 0.375rem 0.75rem;
    border-radius: var(--r-pill);
    background-color: var(--bone);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media (hover: hover) and (pointer: fine) {
    .case:hover .ad-scan {
      top: 72%;
    }
  }

  /* ---------- Liste der Fallakten: grosse Zeilen mit Haarlinien ---------- */

  .files {
    margin-top: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid var(--steel);
  }

  .file {
    border-bottom: 1px solid var(--steel);
  }

  .file summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.625rem 1rem;
    padding-block: clamp(1.25rem, 2.6vw, 2.25rem);
    list-style: none;
  }

  .file-num {
    padding-top: 0.5rem;
    color: var(--ash);
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
  }

  .file-main {
    display: grid;
    gap: 0.625rem;
  }

  /* Titel in Grau; beim Überfahren und im offenen Zustand hell */
  .file-title {
    color: var(--ash);
    font-size: clamp(1.625rem, 1.05rem + 2.3vw, 3.25rem);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-heading);
    line-height: 1;
    text-transform: uppercase;
    transition: color var(--dur-2) var(--ease);
  }

  .file-quote {
    color: var(--ash);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .file-tags {
    display: flex;
    flex-wrap: wrap;
    grid-column: 2;
    gap: 0.375rem;
  }

  .file-toggle {
    grid-row: 1;
    grid-column: 3;
  }

  .file[open] .file-title {
    color: var(--bone);
  }

  .file[open] .file-toggle {
    border-color: var(--acid);
    background-color: var(--acid);
    color: var(--ink);
    transform: rotate(45deg);
  }

  .file-body {
    display: grid;
    gap: 1.25rem;
    padding: 0 0 2rem;
  }

  @media (hover: hover) {
    .file summary:hover .file-title {
      color: var(--bone);
    }

    .file summary:hover .file-toggle {
      border-color: var(--acid);
    }
  }

  @media (min-width: 48rem) {
    .file summary {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 1.5rem;
    }

    .file-num {
      align-self: start;
      padding-top: 0.75rem;
    }

    .file-tags {
      grid-column: 3;
      justify-content: flex-end;
    }

    .file-toggle {
      grid-column: 4;
    }

    .file-body {
      padding-left: 5rem;
    }

    .case-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .case {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 4vw, 4rem);
    }

    .case-visual {
      min-height: 100%;
    }
  }
</style>
