---
/**
 * 0x0B Kontakt: Kontaktdaten und Formular auf einer grossen Bühne.
 * Validierung mit dem gemeinsamen Schema aus @psyber/survey, POST an {PUBLIC_API_BASE}/v1/contact.
 * Verhalten: src/scripts/contact.ts (wird erst nachgeladen, wenn das Formular in Sicht kommt).
 */
import Icon from '@psyber/ui/components/Icon.astro';
import { TURNSTILE_ORIGIN } from '@psyber/config/security';
import { CONTACT_LIMITS, interessen } from '@psyber/survey';
import { contact, href, isTodo, sites, turnstileSiteKey } from '../../config/site.ts';
import SectionHead from '../SectionHead.astro';

const useTurnstile = !sites.apiMock && turnstileSiteKey !== '';

// Turnstile nur auf dieser Seite erlauben (CSP per Meta-Tag).
if (useTurnstile) {
  Astro.csp?.insertScriptResource(TURNSTILE_ORIGIN);
  Astro.csp?.insertDirective(`frame-src ${TURNSTILE_ORIGIN}`);
}

const fields = {
  name: 'kontakt-name',
  email: 'kontakt-email',
  phone: 'kontakt-phone',
  plzOrt: 'kontakt-plz-ort',
  nachricht: 'kontakt-nachricht',
  datenschutz: 'kontakt-datenschutz',
};
---

<section class="sheet kontakt" id="kontakt" aria-labelledby="kontakt-title">
  <div class="wrap">
    <div class="stage kontakt-grid">
      <div class="kontakt-info">
        <SectionHead
          num="0x0B"
          kicker="Kontakt"
          title="Kontakt. Lassen Sie uns sprechen."
          id="kontakt-title"
        />

        <dl class="kontakt-list">
          <div>
            <dt class="label-up">
              <Icon name="mail" size={16} />
              E-Mail
            </dt>
            <dd>
              {isTodo(contact.email) ? (
                contact.email
              ) : (
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              )}
            </dd>
          </div>
          <div>
            <dt class="label-up">
              <Icon name="phone" size={16} />
              Telefon/WhatsApp
            </dt>
            <dd>
              {isTodo(contact.phone) ? (
                contact.phone
              ) : (
                <a href={`tel:${contact.phone.replace(/\s+/g, '')}`}>{contact.phone}</a>
              )}
            </dd>
          </div>
          <div>
            <dt class="label-up">
              <Icon name="map-pin" size={16} />
              Region
            </dt>
            <dd>{contact.region}</dd>
          </div>
        </dl>
      </div>

      <div class="kontakt-panel">
        <form
          class="kontakt-form"
          novalidate
          data-contact
          data-api={sites.api}
          data-turnstile-key={useTurnstile ? turnstileSiteKey : undefined}
        >
          <p class="form-note">
            Felder mit <span aria-hidden="true">*</span>
            <span class="sr-only">Stern</span> sind Pflicht.
          </p>

          <div class="form-row">
            <div class="field">
              <label class="label" for={fields.name}>
                Name{' '}
                <span class="req" aria-hidden="true">
                  *
                </span>
              </label>
              <input
                class="input"
                id={fields.name}
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength={CONTACT_LIMITS.name.max}
              />
              <p class="field-error" id={`${fields.name}-error`} data-error-for="name" hidden></p>
            </div>

            <div class="field">
              <label class="label" for={fields.email}>
                E-Mail{' '}
                <span class="req" aria-hidden="true">
                  *
                </span>
              </label>
              <input
                class="input"
                id={fields.email}
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                maxlength={CONTACT_LIMITS.email.max}
              />
              <p class="field-error" id={`${fields.email}-error`} data-error-for="email" hidden></p>
            </div>
          </div>

          <div class="form-row">
            <div class="field">
              <label class="label" for={fields.phone}>
                Telefon <span class="label-hint">(optional)</span>
              </label>
              <input
                class="input"
                id={fields.phone}
                name="phone"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                maxlength={CONTACT_LIMITS.phone.max}
              />
              <p class="field-error" id={`${fields.phone}-error`} data-error-for="phone" hidden></p>
            </div>

            <div class="field">
              <label class="label" for={fields.plzOrt}>
                PLZ und Ort{' '}
                <span class="req" aria-hidden="true">
                  *
                </span>
              </label>
              <input
                class="input"
                id={fields.plzOrt}
                name="plzOrt"
                type="text"
                required
                maxlength={CONTACT_LIMITS.plzOrt.max}
              />
              <p
                class="field-error"
                id={`${fields.plzOrt}-error`}
                data-error-for="plzOrt"
                hidden
              ></p>
            </div>
          </div>

          <fieldset class="field" aria-describedby="kontakt-interesse-error">
            <legend class="label">
              Interesse{' '}
              <span class="req" aria-hidden="true">
                *
              </span>
            </legend>
            <div class="chips">
              {Object.entries(interessen).map(([value, label]) => (
                <label class="chip">
                  <input type="radio" name="interesse" value={value} required />
                  <span>{label}</span>
                </label>
              ))}
            </div>
            <p
              class="field-error"
              id="kontakt-interesse-error"
              data-error-for="interesse"
              hidden
            ></p>
          </fieldset>

          <div class="field">
            <label class="label" for={fields.nachricht}>
              Nachricht <span class="label-hint">(optional)</span>
            </label>
            <textarea
              class="input"
              id={fields.nachricht}
              name="nachricht"
              rows="5"
              maxlength={CONTACT_LIMITS.nachricht.max}
              aria-describedby="kontakt-nachricht-count"
            ></textarea>
            <p class="form-count mono" id="kontakt-nachricht-count">
              <span data-count-current>0</span> / 2000 Zeichen
            </p>
            <p
              class="field-error"
              id={`${fields.nachricht}-error`}
              data-error-for="nachricht"
              hidden
            ></p>
          </div>

          <div class="field">
            <label class="check">
              <input
                class="checkbox"
                type="checkbox"
                id={fields.datenschutz}
                name="datenschutz"
                required
              />
              <span>
                Ich habe die
                <a class="link" href={href('/datenschutz')}>
                  Datenschutzerklärung
                </a>
                gelesen.{' '}
                <span class="req" aria-hidden="true">
                  *
                </span>
              </span>
            </label>
            <p
              class="field-error"
              id={`${fields.datenschutz}-error`}
              data-error-for="datenschutz"
              hidden
            ></p>
          </div>

          <!-- Honeypot: für Menschen unsichtbar und nicht per Tab erreichbar -->
          <div class="hp" aria-hidden="true">
            <label>
              Website (bitte leer lassen)
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          {useTurnstile && <div class="form-turnstile" data-turnstile></div>}

          <div class="form-actions">
            <button class="btn btn-primary" type="submit" data-submit>
              <span data-submit-label>Anfrage senden</span>
              <Icon name="send" size={18} />
            </button>
            {sites.apiMock && (
              <p class="form-preview mono">
                Vorschau: Die Anfrage wird nicht gesendet und nicht gespeichert.
              </p>
            )}
          </div>

          <p class="form-status form-error" role="alert" data-form-error hidden>
            <Icon name="circle-alert" size={20} />
            <span>
              Das hat nicht geklappt. Bitte versuchen Sie es nochmals oder schreiben Sie uns direkt
              an
              {contact.email}.
            </span>
          </p>
        </form>

        <div class="form-success" role="status" tabindex="-1" data-form-success hidden>
          <span class="form-success-icon" aria-hidden="true">
            <Icon name="check" size={28} />
          </span>
          <p class="form-success-text">
            Danke! Wir melden uns innert zwei Arbeitstagen per E-Mail oder auf der Nummer, die Sie
            angegeben haben.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Danach folgt der Footer, kein weiterer Bogen */
  .kontakt {
    padding-bottom: clamp(1.25rem, 3vw, 2.5rem);
  }

  .kontakt-grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(1.5rem, 0.6rem + 3.6vw, 4.5rem);
  }

  .kontakt-info {
    display: grid;
    align-content: start;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  /* Kontaktwege als grosse Zeilen */
  .kontakt-list {
    display: grid;
    border-top: 1px solid var(--steel);
  }

  .kontakt-list > div {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--steel);
  }

  .kontakt-list dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .kontakt-list dd {
    color: var(--bone);
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2.125rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .kontakt-list a {
    text-decoration: none;
    transition: color var(--dur-2) var(--ease);
  }

  .kontakt-list a:hover {
    color: var(--acid);
  }

  .kontakt-form {
    display: grid;
    gap: 1.5rem;
  }

  .form-note {
    color: var(--ash);
    font-size: var(--fs-small);
  }

  .form-row {
    display: grid;
    gap: 1.5rem;
  }

  .req {
    color: var(--acid);
  }

  fieldset.field {
    min-width: 0;
  }

  fieldset.field legend {
    margin-bottom: 0.5rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.375rem 1.125rem;
    border: 1px solid var(--steel);
    border-radius: var(--r-pill);
    background-color: var(--pit);
    color: var(--bone);
    font-size: var(--fs-small);
    font-weight: 600;
    transition:
      background-color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }

  .chip input:checked + span {
    border-color: var(--acid);
    background-color: var(--acid);
    color: var(--ink);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .chips:global([data-invalid]) .chip span {
    border-color: var(--crit);
  }

  .form-count {
    color: var(--ash);
    font-size: var(--fs-micro);
    text-align: right;
  }

  .form-turnstile {
    min-height: 1px;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .form-preview {
    color: var(--ash);
    font-size: var(--fs-micro);
  }

  .form-status {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.125rem;
    border-radius: var(--r-input);
    line-height: 1.5;
  }

  .form-error {
    border: 1.5px solid var(--crit);
    background-color: color-mix(in srgb, var(--crit) 12%, transparent);
    color: var(--bone);
  }

  .form-error :global(.icon) {
    flex: none;
    margin-top: 0.15em;
    color: var(--crit);
  }

  .form-success {
    display: grid;
    align-content: center;
    gap: 1.5rem;
    min-height: 18rem;
    outline-offset: 6px;
  }

  .form-success-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background-color: var(--acid);
    color: var(--ink);
    box-shadow: var(--glow-acid-hi);
  }

  .form-success-text {
    max-width: 20em;
    color: var(--bone);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  @media (hover: hover) {
    .chip:hover span {
      border-color: var(--acid);
    }
  }

  @media (min-width: 40rem) {
    .form-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .kontakt-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
  }
</style>
