---
/**
 * «Der erste Schritt»: Abschluss-CTA mit Mini-Check. Die drei Antworten sind riesige Zeilen
 * auf violettem Bogen (eine Radio-Gruppe).
 * survey: Button führt zur Umfrage, die Auswahl wandert als ?fokus= mit.
 * launch: Button führt zum Kontakt, die Auswahl wird erste Zeile der Nachricht.
 * Verhalten: src/scripts/first-step.ts. Ohne JS führt der Button ohne Fokus weiter.
 */
import Icon from '@psyber/ui/components/Icon.astro';
import { isLaunch, surveyUrl } from '../../config/site.ts';
import SectionHead from '../SectionHead.astro';

const choices = [
  {
    value: 'vor',
    title: 'Vor dem Klick',
    text: 'Betrug erkennen',
    note: 'Schwerpunkt: vor dem Klick',
  },
  {
    value: 'nach',
    title: 'Nach dem Klick',
    text: 'Geräte und Heimnetz',
    note: 'Schwerpunkt: nach dem Klick',
  },
  {
    value: 'unklar',
    title: 'Keine Ahnung',
    text: 'Genau dafür gibt es die Umfrage.',
    note: 'Schwerpunkt: noch unklar',
  },
];

const base = surveyUrl();
---

<section data-lazy class="sheet sheet-space on-space first" aria-labelledby="first-title">
  <div class="wrap first-inner">
    <SectionHead
      kicker="Der erste Schritt"
      title="Wo fühlen Sie sich am unsichersten?"
      id="first-title"
      size="xl"
    />

    <form
      class="first-form"
      data-first-step
      data-mode={isLaunch ? 'launch' : 'survey'}
      data-base={isLaunch ? undefined : base}
    >
      <fieldset class="choices">
        <legend class="sr-only">Wo fühlen Sie sich am unsichersten?</legend>
        {choices.map((choice) => (
          <label class="choice">
            <input type="radio" name="fokus" value={choice.value} data-note={choice.note} />
            <span class="choice-main">
              <span class="choice-title">{choice.title}</span>
              <span class="choice-text">{choice.text}</span>
            </span>
            <span class="orb choice-mark" aria-hidden="true">
              <span class="choice-arrow">
                <Icon name="arrow-right" size={20} />
              </span>
              <span class="choice-check">
                <Icon name="check" size={20} strokeWidth={2.4} />
              </span>
            </span>
          </label>
        ))}
      </fieldset>

      <div class="first-actions">
        {isLaunch ? (
          <a class="btn btn-primary" href="#kontakt" data-first-cta>
            <span>Session anfragen</span>
            <Icon name="arrow-right" size={18} class="icon-shift" />
          </a>
        ) : (
          <a class="btn btn-primary" href={base} data-first-cta>
            <span>Umfrage starten</span>
            <Icon name="arrow-right" size={18} class="icon-shift" />
          </a>
        )}
        <a class="btn btn-secondary" href="#kontakt">
          <span>Direkt Kontakt aufnehmen</span>
          <Icon name="arrow-right" size={18} class="icon-shift" />
        </a>
      </div>
    </form>
  </div>
</section>

<style>
  .first-inner {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .first-form {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .choices {
    display: grid;
    border-top: 1px solid var(--border-strong);
  }

  /* Antwort als riesige Zeile */
  .choice {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: clamp(1rem, 2.2vw, 1.75rem);
    border-bottom: 1px solid var(--border-strong);
    cursor: pointer;
  }

  .choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .choice-main {
    display: grid;
    gap: 0.375rem;
  }

  .choice-title {
    color: var(--bone);
    font-size: clamp(2rem, 0.9rem + 4.4vw, 5.25rem);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-display);
    line-height: 0.95;
    text-transform: uppercase;
    transition:
      color var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .choice-text {
    color: var(--fg-muted);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .choice-mark {
    width: 3.25rem;
    height: 3.25rem;
  }

  .choice-arrow,
  .choice-check {
    display: grid;
  }

  .choice-check {
    display: none;
  }

  .choice:has(input:checked) .choice-title {
    color: var(--acid);
  }

  .choice:has(input:checked) .choice-mark {
    border-color: var(--acid);
    background-color: var(--acid);
    color: var(--ink);
  }

  .choice:has(input:checked) .choice-arrow {
    display: none;
  }

  .choice:has(input:checked) .choice-check {
    display: grid;
  }

  .choice:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .first-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .choice:hover .choice-title {
      transform: translateX(0.75rem);
    }

    .choice:hover .choice-mark {
      border-color: var(--acid);
    }
  }
</style>
