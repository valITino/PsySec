---
/**
 * Klick-Simulator: eine fiktive Betrugs-SMS, in zwei Schritten erklärt.
 *   Schritt 1 (Psychologie, vor dem Klick): drei Warnsignale werden markiert.
 *   Schritt 2 (Technik, nach dem Klick): der DNS-Filter blockiert die Seite.
 *
 * Als Bühne direkt unter dem Hero: links Titel und Steuerung, rechts das Gerät.
 * Ohne JS und bei reduzierter Bewegung zeigt das Markup Schritt 1 vollständig.
 * Alle Texte stehen im DOM; Screenreader lesen den ganzen Ablauf ohne die Zeitleiste zu bedienen.
 * Verhalten: src/scripts/simulator.ts
 */
import Icon from '@psyber/ui/components/Icon.astro';
import Kicker from '@psyber/ui/components/Kicker.astro';
import stickerUrl from '@psyber/ui/brand/sticker-netter-versuch.svg?url';

const steps = [
  { step: 1, num: '01', title: 'Psychologie', sub: 'vor dem Klick' },
  { step: 2, num: '02', title: 'Technik', sub: 'nach dem Klick' },
];
---

<div class="sim stage" data-sim>
  <div class="sim-head">
    <Kicker>Klick-Simulator</Kicker>
    <h2 class="display h2">Eine SMS. Zwei Schritte.</h2>
  </div>

  <div
    class="sim-phone"
    role="group"
    aria-label="Klick-Simulator: Beispiel einer betrügerischen SMS"
  >
    <div class="sim-screen">
      <div class="sim-status mono">
        <span class="sim-time" data-sim-time aria-label="Uhrzeit in der Schweiz">
          --:--
        </span>
        <span class="sim-island" aria-hidden="true"></span>
        <span class="sim-place">
          <Icon name="map-pin" size={12} strokeWidth={2} />
          Schweiz
        </span>
      </div>

      <div class="sim-views">
        <!-- Ansicht 1: Nachrichten -->
        <div class="sim-view sim-sms">
          <div class="sim-thread">
            <span class="sim-avatar" aria-hidden="true">
              <Icon name="user" size={16} />
            </span>
            <span class="sim-sender">
              <strong>Unbekannter Absender</strong>
              <span class="mono">SMS · heute</span>
            </span>
          </div>

          <div class="sim-messages">
            <p class="sim-bubble">
              Ihr Paket konnte nicht zugestellt werden. Zollgebühr
              <mark class="sim-mark" data-mark="betrag">
                CHF 2.40
              </mark>
              <mark class="sim-mark" data-mark="zeit">
                bis heute 23:59
              </mark>
              bezahlen:
              <span class="sim-url">
                <mark class="sim-mark" data-mark="adresse">
                  paket-zustellung-ch.info
                </mark>
                /z/8812
                <span class="sim-tap" aria-hidden="true">
                  <Icon name="pointer" size={20} strokeWidth={2} />
                </span>
              </span>
            </p>

            <ul class="sim-signals" aria-label="Warnsignale in dieser Nachricht">
              <li data-signal="zeit">
                <Icon name="clock" size={15} strokeWidth={2} />
                <span>
                  <strong>Zeitdruck</strong>
                </span>
              </li>
              <li data-signal="adresse">
                <Icon name="link" size={15} strokeWidth={2} />
                <span>
                  <strong>Fremde Adresse</strong>
                </span>
              </li>
              <li data-signal="betrag">
                <Icon name="coins" size={15} strokeWidth={2} />
                <span>
                  <strong>Kleiner Betrag</strong>
                  <span class="sim-signal-note">Kleine Beträge senken die Vorsicht.</span>
                </span>
              </li>
            </ul>

            <p class="sim-verdict">
              <Icon name="shield-alert" size={16} strokeWidth={2} />
              <span>3 Warnsignale erkannt. Nicht klicken.</span>
            </p>
          </div>

          <div class="sim-compose" aria-hidden="true">
            <span class="sim-compose-field">Nachricht</span>
            <span class="sim-compose-send">
              <Icon name="send" size={14} strokeWidth={2} />
            </span>
          </div>
        </div>

        <!-- Ansicht 2: Browser -->
        <div class="sim-view sim-browser">
          <div class="sim-urlbar mono">
            <Icon name="triangle-alert" size={13} strokeWidth={2} />
            <span>paket-zustellung-ch.info/z/8812</span>
          </div>

          <div class="sim-error">
            <span class="sim-error-icon" aria-hidden="true">
              <Icon name="wifi-off" size={26} />
            </span>
            <p class="sim-error-title">Diese Seite ist nicht erreichbar</p>
            <p class="sim-error-code mono" aria-hidden="true">
              dns: blockiert
            </p>
          </div>

          <p class="sim-note">
            <Icon name="shield-check" size={17} strokeWidth={2} />
            <span>
              <strong>Blockiert vom DNS-Filter:</strong> Die Adresse ist als Betrug bekannt, Ihr
              Browser erreicht sie gar nicht erst.
            </span>
          </p>

          <p class="sim-small">
            Und wenn eine Betrugsseite noch neu ist: Ein Passwort-Manager füllt auf falschen
            Adressen nichts aus, und ein Zwei-Faktor-Login erschwert den Zugriff.
          </p>

          <div class="sim-toolbar" aria-hidden="true">
            <Icon name="arrow-left" size={16} />
            <Icon name="arrow-right" size={16} />
            <Icon name="share" size={16} />
            <Icon name="more-horizontal" size={16} />
          </div>
        </div>
      </div>
    </div>
    <!-- Erscheint, sobald der DNS-Filter blockiert hat -->
    <img
      class="sticker sim-sticker"
      src={stickerUrl}
      width="432"
      height="432"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="sim-controls" data-sim-controls>
    <ol class="sim-steps">
      {steps.map((item) => (
        <li>
          <button
            type="button"
            class="sim-step"
            data-sim-step={item.step}
            data-sim-station={item.step}
            aria-pressed={item.step === 1 ? 'true' : 'false'}
          >
            <span class="sim-step-num mono" aria-hidden="true">
              {item.num}
            </span>
            <span class="sim-step-label">
              <span class="sr-only">Schritt {item.step}: </span>
              {item.title} <span class="sim-step-sub">· {item.sub}</span>
            </span>
            <span class="orb sim-step-orb" aria-hidden="true">
              <Icon name="play" size={16} />
            </span>
          </button>
        </li>
      ))}
    </ol>

    <div class="sim-scrub">
      <label class="label-up sim-label" for="sim-range">
        Ziehen zum Abspielen
      </label>
      <div class="sim-track">
        <input
          class="sim-range"
          id="sim-range"
          type="range"
          min="0"
          max="100"
          step="1"
          value="0"
          aria-valuetext="Schritt 1 von 2: Psychologie, vor dem Klick. Noch kein Warnsignal markiert."
          data-sim-range
        />
        <span class="sim-click" aria-hidden="true">
          Klick
        </span>
      </div>
    </div>
  </div>
</div>

<style>
  .sim {
    --sim-w: clamp(17rem, 40svh, 20.5rem);
    /*
     * Breite des Geräts als reine Rechnung: höchstens --sim-w, auf sehr schmalen Bildschirmen
     * die Breite des Inhaltsbereichs. Daran hängt die Schriftgrösse im Gerät. Bewusst keine
     * Container Query: Mit cqw-Einheiten hat der Browser bei jedem Layout der Seite das ganze
     * Gerät mehrfach neu gestaltet und gesetzt (rund fünfmal so viel Layout-Zeit).
     */
    --sim-pad: clamp(1.25rem, 0.5rem + 3.4vw, 4rem);
    --sim-phone: min(100vw - 2 * var(--gutter) - 2 * var(--sim-pad), var(--sim-w));
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
    padding: var(--sim-pad);
  }

  .sim-head {
    display: grid;
    gap: 1rem;
  }

  /* ---------- Smartphone ---------- */

  .sim-phone {
    width: min(100%, var(--sim-phone));
    justify-self: center;
    aspect-ratio: 320 / 610;
    padding: 9px;
    border: 1px solid var(--hairline);
    border-radius: 13.5% / 7%;
    background-color: var(--pit);
  }

  .sim-screen {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 11.5% / 6%;
    background-color: var(--void);
    color: var(--fg);
    /* Alle Masse im Gerät skalieren mit der Gerätebreite (Innenbreite = Breite − 20 px) */
    font-size: calc((var(--sim-phone) - 20px) * 0.0482);
    line-height: 1.42;
  }

  .sim-status {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.85em 1.35em 0.4em;
    color: var(--fg-strong);
    font-size: 0.83em;
    font-weight: 600;
  }

  .sim-island {
    width: 5.2em;
    height: 1.45em;
    border-radius: 1em;
    background-color: var(--pit);
    border: 1px solid var(--hairline);
  }

  .sim-place {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3em;
  }

  .sim-place :global(.icon) {
    width: 1em;
    height: 1em;
    color: var(--fg-muted);
  }

  .sim-views {
    position: relative;
    flex: 1;
  }

  .sim-view {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  /* ---------- Ansicht 1: SMS ---------- */

  .sim-thread {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.55em 1.1em 0.75em;
    border-bottom: 1px solid var(--hairline);
  }

  .sim-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.3em;
    height: 2.3em;
    border-radius: 50%;
    background-color: var(--graphite);
    color: var(--fg-muted);
  }

  .sim-avatar :global(.icon) {
    width: 1.15em;
    height: 1.15em;
  }

  .sim-sender {
    display: grid;
    line-height: 1.25;
  }

  .sim-sender strong {
    font-size: 0.93em;
    font-weight: 700;
  }

  .sim-sender .mono {
    color: var(--fg-muted);
    font-size: 0.76em;
  }

  .sim-messages {
    display: grid;
    align-content: start;
    gap: 0.8em;
    padding: 1em 1em 0.9em;
  }

  .sim-bubble {
    position: relative;
    max-width: 94%;
    padding: 0.75em 0.9em;
    border-radius: 1.2em 1.2em 1.2em 0.35em;
    background-color: var(--graphite);
    color: var(--fg-strong);
    text-wrap: wrap;
    animation: sim-pop var(--dur-3) var(--ease) both;
  }

  .sim-url {
    position: relative;
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  /* Marker: wischt als amberfarbener Leuchtstift ein */
  .sim-mark {
    padding: 0.05em 0.1em;
    border-radius: 0.25em;
    background-color: transparent;
    background-image: linear-gradient(var(--amber), var(--amber));
    background-position: 0 0;
    background-repeat: no-repeat;
    background-size: 0% 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    color: inherit;
    font-weight: inherit;
    transition:
      background-size var(--dur-3) var(--ease),
      color var(--dur-2) var(--ease);
  }

  .sim-tap {
    position: absolute;
    top: 50%;
    left: 34%;
    display: grid;
    place-items: center;
    width: 3em;
    height: 3em;
    margin: -1.5em 0 0 -1.5em;
    border: 2px solid var(--fg-strong);
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--fg-strong) 22%, transparent);
    color: var(--fg-strong);
    opacity: 0;
    pointer-events: none;
    transform: scale(1.5);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-tap :global(.icon) {
    width: 1.3em;
    height: 1.3em;
    transform: translate(12%, 18%);
  }

  .sim-signals {
    display: grid;
    gap: 0.5em;
    padding-left: 0.75em;
    border-left: 2px solid transparent;
    transition: border-color var(--dur-3) var(--ease);
  }

  .sim-signals li {
    display: flex;
    align-items: flex-start;
    gap: 0.55em;
    font-size: 0.93em;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-signals :global(.icon) {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.12em;
    color: var(--amber);
  }

  .sim-signals strong {
    color: var(--fg-strong);
    font-weight: 700;
  }

  .sim-signal-note {
    display: block;
    color: var(--fg);
    font-size: 0.9em;
  }

  .sim-verdict {
    display: flex;
    align-items: center;
    gap: 0.5em;
    justify-self: start;
    padding: 0.5em 0.8em;
    border-radius: 0.7em;
    background-color: var(--amber);
    color: var(--ink);
    font-size: 0.9em;
    font-weight: 700;
    line-height: 1.25;
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-verdict :global(.icon) {
    flex: none;
    width: 1.2em;
    height: 1.2em;
  }

  .sim-compose {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: auto;
    padding: 0.7em 1em 1.1em;
  }

  .sim-compose-field {
    flex: 1;
    padding: 0.5em 0.9em;
    border: 1px solid var(--hairline);
    border-radius: 1.2em;
    color: var(--ash);
    font-size: 0.86em;
  }

  .sim-compose-send {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background-color: var(--graphite);
    color: var(--fg-muted);
  }

  .sim-compose-send :global(.icon) {
    width: 1em;
    height: 1em;
  }

  .sim-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding: 0.7em 1.4em 0.4em;
    border-top: 1px solid var(--hairline);
    color: var(--fg-muted);
  }

  .sim-toolbar :global(.icon) {
    width: 1.2em;
    height: 1.2em;
  }

  /* ---------- Ansicht 2: Browser ---------- */

  .sim-browser {
    gap: 0.9em;
    padding: 0.4em 1em 1em;
    opacity: 0;
    pointer-events: none;
    transform: translateX(8%);
  }

  .sim-urlbar {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55em 0.8em;
    border: 1px solid var(--hairline);
    border-radius: 0.8em;
    background-color: var(--pit);
    color: var(--fg);
    font-size: 0.78em;
  }

  .sim-urlbar span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sim-urlbar :global(.icon) {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    color: var(--amber);
  }

  .sim-error {
    display: grid;
    justify-items: center;
    gap: 0.45em;
    padding-block: 1.6em 0.9em;
    text-align: center;
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-error-icon {
    display: grid;
    place-items: center;
    width: 3.6em;
    height: 3.6em;
    margin-bottom: 0.3em;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background-color: var(--graphite);
    color: var(--fg-muted);
  }

  .sim-error-icon :global(.icon) {
    width: 1.8em;
    height: 1.8em;
  }

  .sim-error-title {
    color: var(--fg-strong);
    font-size: 1.12em;
    font-weight: 800;
    line-height: 1.2;
  }

  .sim-error-code {
    color: var(--fg-muted);
    font-size: 0.78em;
  }

  .sim-note {
    display: flex;
    align-items: flex-start;
    gap: 0.55em;
    padding: 0.7em 0.8em;
    border: 1px solid color-mix(in srgb, var(--ok) 60%, transparent);
    border-radius: 0.8em;
    background-color: color-mix(in srgb, var(--ok) 12%, transparent);
    color: var(--fg-strong);
    font-size: 0.86em;
    line-height: 1.35;
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-note :global(.icon) {
    flex: none;
    width: 1.3em;
    height: 1.3em;
    margin-top: 0.05em;
    color: var(--ok);
  }

  .sim-small {
    color: var(--fg);
    font-size: 0.78em;
    line-height: 1.4;
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease);
  }

  /*
   * Zustände
   * Grundzustand im CSS: Zeitleiste auf 0 (nur die SMS). simulator.ts schaltet die Schritte
   * über Klassen am Wurzelelement (.is-zeit, .is-adresse, …) und setzt `data-ready`.
   * Ohne JS oder bei reduzierter Bewegung zeigt der Block weiter unten Schritt 1 vollständig.
   */
  .sim.is-zeit .sim-signals {
    border-left-color: var(--amber);
  }

  .sim.is-zeit [data-mark='zeit'],
  .sim.is-adresse [data-mark='adresse'],
  .sim.is-betrag [data-mark='betrag'] {
    background-size: 100% 100%;
    color: var(--ink);
    font-weight: 650;
  }

  .sim.is-zeit [data-signal='zeit'],
  .sim.is-adresse [data-signal='adresse'],
  .sim.is-betrag [data-signal='betrag'],
  .sim.is-verdict .sim-verdict {
    opacity: 1;
    transform: none;
  }

  .sim.is-tap .sim-tap {
    opacity: 1;
    transform: scale(1);
  }

  .sim.is-press .sim-tap {
    transform: scale(0.78);
  }

  .sim.is-browser .sim-sms {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-8%);
  }

  .sim.is-browser .sim-browser {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .sim.is-error .sim-error,
  .sim.is-note .sim-note {
    opacity: 1;
    transform: none;
  }

  .sim.is-small .sim-small {
    opacity: 1;
  }

  /* Sticker auf der Ecke des Geräts: klebt sich auf, wenn der Betrug blockiert ist */
  .sim-phone {
    position: relative;
  }

  .sim-sticker {
    --sticker-size: clamp(5.5rem, 4rem + 4vw, 8rem);
    --sticker-tilt: 12deg;
    position: absolute;
    right: calc(var(--sticker-size) * -0.4);
    bottom: 3%;
    opacity: 0;
    transform: rotate(-14deg) scale(0.5);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-3) cubic-bezier(0.2, 1.4, 0.4, 1);
  }

  .sim.is-note .sim-sticker {
    opacity: 1;
    transform: rotate(var(--sticker-tilt)) scale(1);
  }

  /* Statischer Zustand, solange kein Skript übernommen hat: Schritt 1 vollständig */
  @media (scripting: none), (prefers-reduced-motion: reduce) {
    .sim:not([data-ready]) .sim-mark {
      background-size: 100% 100%;
      color: var(--ink);
      font-weight: 650;
    }

    .sim:not([data-ready]) .sim-signals {
      border-left-color: var(--amber);
    }

    .sim:not([data-ready]) .sim-signals li,
    .sim:not([data-ready]) .sim-verdict {
      opacity: 1;
      transform: none;
    }
  }

  /* Ohne Skripte: beide Ansichten untereinander, keine Bedienelemente */
  @media (scripting: none) {
    .sim-phone {
      aspect-ratio: auto;
    }

    .sim-views {
      display: grid;
    }

    .sim-view {
      position: static;
    }

    .sim-browser {
      border-top: 1px solid var(--hairline);
      padding-top: 1em;
      opacity: 1;
      transform: none;
    }

    .sim-browser .sim-error,
    .sim-browser .sim-note,
    .sim-browser .sim-small {
      opacity: 1;
      transform: none;
    }

    .sim-controls {
      display: none;
    }

    .sim-sticker {
      opacity: 1;
      transform: rotate(var(--sticker-tilt));
    }
  }

  @keyframes sim-pop {
    from {
      opacity: 0;
      transform: translateY(0.6em) scale(0.97);
    }
  }

  /* ---------- Steuerung ---------- */

  .sim-controls {
    display: grid;
    gap: 1.75rem;
  }

  .sim-steps {
    display: grid;
    border-top: 1px solid var(--hairline);
  }

  /* Die zwei Schritte als grosse Zeilen */
  .sim-step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--hairline);
    color: var(--ash);
    text-align: left;
    transition: color var(--dur-2) var(--ease);
  }

  .sim-step-num {
    color: inherit;
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .sim-step-label {
    font-size: clamp(1.375rem, 1rem + 1.7vw, 2.5rem);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-heading);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .sim-step-sub {
    display: block;
    margin-top: 0.375rem;
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--ls-label);
  }

  .sim-step[aria-pressed='true'] {
    color: var(--bone);
  }

