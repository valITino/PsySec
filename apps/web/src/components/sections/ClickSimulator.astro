---
/**
 * Klick-Simulator: eine fiktive Betrugs-SMS, in zwei Schritten erklärt.
 *   Schritt 1 (Psychologie, vor dem Klick): drei Warnsignale werden markiert.
 *   Schritt 2 (Technik, nach dem Klick): der DNS-Filter blockiert die Seite.
 *
 * Ohne JS und bei reduzierter Bewegung zeigt das Markup Schritt 1 vollständig.
 * Alle Texte stehen im DOM; Screenreader lesen den ganzen Ablauf ohne die Zeitleiste zu bedienen.
 * Verhalten: src/scripts/simulator.ts
 */
import Icon from '@psyber/ui/components/Icon.astro';
---

<div class="sim" data-sim>
  <div
    class="sim-phone"
    role="group"
    aria-label="Klick-Simulator: Beispiel einer betrügerischen SMS"
  >
    <div class="sim-screen">
      <div class="sim-status mono">
        <span class="sim-time" data-sim-time aria-label="Uhrzeit in Zürich">
          --:--
        </span>
        <span class="sim-island" aria-hidden="true"></span>
        <span class="sim-city">
          <Icon name="map-pin" size={12} strokeWidth={2} />
          Zürich
        </span>
      </div>

      <div class="sim-views">
        <!-- Ansicht 1: Nachrichten -->
        <div class="sim-view sim-sms">
          <div class="sim-thread">
            <span class="sim-avatar" aria-hidden="true">
              <Icon name="user" size={16} />
            </span>
            <span class="sim-sender">
              <strong>Unbekannter Absender</strong>
              <span class="mono">SMS · heute</span>
            </span>
          </div>

          <div class="sim-messages">
            <p class="sim-bubble">
              Ihr Paket konnte nicht zugestellt werden. Zollgebühr
              <mark class="sim-mark" data-mark="betrag">
                CHF 2.40
              </mark>
              <mark class="sim-mark" data-mark="zeit">
                bis heute 23:59
              </mark>
              bezahlen:
              <span class="sim-url">
                <mark class="sim-mark" data-mark="adresse">
                  paket-zustellung-ch.info
                </mark>
                /z/8812
                <span class="sim-tap" aria-hidden="true">
                  <Icon name="pointer" size={20} strokeWidth={2} />
                </span>
              </span>
            </p>

            <ul class="sim-signals" aria-label="Warnsignale in dieser Nachricht">
              <li data-signal="zeit">
                <Icon name="clock" size={15} strokeWidth={2} />
                <span>
                  <strong>Zeitdruck</strong>
                </span>
              </li>
              <li data-signal="adresse">
                <Icon name="link" size={15} strokeWidth={2} />
                <span>
                  <strong>Fremde Adresse</strong>
                </span>
              </li>
              <li data-signal="betrag">
                <Icon name="coins" size={15} strokeWidth={2} />
                <span>
                  <strong>Kleiner Betrag</strong>
                  <span class="sim-signal-note">Kleine Beträge senken die Vorsicht.</span>
                </span>
              </li>
            </ul>

            <p class="sim-verdict">
              <Icon name="shield-alert" size={16} strokeWidth={2} />
              <span>3 Warnsignale erkannt. Nicht klicken.</span>
            </p>
          </div>

          <div class="sim-compose" aria-hidden="true">
            <span class="sim-compose-field">Nachricht</span>
            <span class="sim-compose-send">
              <Icon name="send" size={14} strokeWidth={2} />
            </span>
          </div>
        </div>

        <!-- Ansicht 2: Browser -->
        <div class="sim-view sim-browser">
          <div class="sim-urlbar mono">
            <Icon name="triangle-alert" size={13} strokeWidth={2} />
            <span>paket-zustellung-ch.info/z/8812</span>
          </div>

          <div class="sim-error">
            <span class="sim-error-icon" aria-hidden="true">
              <Icon name="wifi-off" size={26} />
            </span>
            <p class="sim-error-title">Diese Seite ist nicht erreichbar</p>
            <p class="sim-error-code mono" aria-hidden="true">
              dns: blockiert
            </p>
          </div>

          <p class="sim-note">
            <Icon name="shield-check" size={17} strokeWidth={2} />
            <span>
              <strong>Blockiert vom DNS-Filter:</strong> Die Adresse ist als Betrug bekannt, Ihr
              Browser erreicht sie gar nicht erst.
            </span>
          </p>

          <p class="sim-small">
            Und wenn eine Betrugsseite noch neu ist: Ein Passwort-Manager füllt auf falschen
            Adressen nichts aus, und ein Zwei-Faktor-Login erschwert den Zugriff.
          </p>

          <div class="sim-toolbar" aria-hidden="true">
            <Icon name="arrow-left" size={16} />
            <Icon name="arrow-right" size={16} />
            <Icon name="share" size={16} />
            <Icon name="more-horizontal" size={16} />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="sim-controls" data-sim-controls>
    <div class="sim-controls-top">
      <label class="sim-label mono" for="sim-range">
        Ziehen zum Abspielen
      </label>
      <div class="sim-buttons">
        <button
          type="button"
          class="sim-step"
          data-sim-step="1"
          aria-pressed="true"
          aria-label="Schritt 1: Psychologie, vor dem Klick"
        >
          Schritt 1
        </button>
        <button
          type="button"
          class="sim-step"
          data-sim-step="2"
          aria-pressed="false"
          aria-label="Schritt 2: Technik, nach dem Klick"
        >
          Schritt 2
        </button>
      </div>
    </div>

    <div class="sim-track">
      <input
        class="sim-range"
        id="sim-range"
        type="range"
        min="0"
        max="100"
        step="1"
        value="0"
        aria-valuetext="Schritt 1 von 2: Psychologie, vor dem Klick. Noch kein Warnsignal markiert."
        data-sim-range
      />
    </div>

    <ol class="sim-stations mono" aria-hidden="true">
      <li data-sim-station="1">
        <span>1. Psychologie</span> <span>· vor dem Klick</span>
      </li>
      <li data-sim-station="2">
        <span>2. Technik</span> <span>· nach dem Klick</span>
      </li>
    </ol>
  </div>
</div>

<style>
  .sim {
    --sim-w: clamp(17rem, 34svh, 19.5rem);
    display: grid;
    gap: 0.875rem;
    width: min(100%, 21.5rem);
  }

  /* ---------- Smartphone ---------- */

  .sim-phone {
    width: min(100%, var(--sim-w));
    justify-self: center;
    aspect-ratio: 320 / 610;
    padding: 9px;
    border: 1px solid var(--line);
    border-radius: 13.5% / 7%;
    background-color: var(--deep);
    container-type: inline-size;
  }

  .sim-screen {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 11.5% / 6%;
    background-color: var(--night);
    color: var(--soft);
    /* Alle Masse im Gerät skalieren mit der Gerätebreite */
    font-size: 4.82cqw;
    line-height: 1.42;
  }

  .sim-status {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0.85em 1.35em 0.4em;
    color: var(--white);
    font-size: 0.83em;
    font-weight: 600;
  }

  .sim-island {
    width: 5.2em;
    height: 1.45em;
    border-radius: 1em;
    background-color: var(--deep);
    border: 1px solid var(--line);
  }

  .sim-city {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3em;
  }

  .sim-city :global(.icon) {
    width: 1em;
    height: 1em;
    color: var(--lav);
  }

  .sim-views {
    position: relative;
    flex: 1;
  }

  .sim-view {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  /* ---------- Ansicht 1: SMS ---------- */

  .sim-thread {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.55em 1.1em 0.75em;
    border-bottom: 1px solid var(--line);
  }

  .sim-avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.3em;
    height: 2.3em;
    border-radius: 50%;
    background-color: var(--aubergine);
    color: var(--lav);
  }

  .sim-avatar :global(.icon) {
    width: 1.15em;
    height: 1.15em;
  }

  .sim-sender {
    display: grid;
    line-height: 1.25;
  }

  .sim-sender strong {
    font-size: 0.93em;
    font-weight: 700;
  }

  .sim-sender .mono {
    color: var(--lav);
    font-size: 0.76em;
  }

  .sim-messages {
    display: grid;
    align-content: start;
    gap: 0.8em;
    padding: 1em 1em 0.9em;
  }

  .sim-bubble {
    position: relative;
    max-width: 94%;
    padding: 0.75em 0.9em;
    border-radius: 1.2em 1.2em 1.2em 0.35em;
    background-color: var(--aubergine);
    color: var(--white);
    text-wrap: wrap;
    animation: sim-pop var(--dur-3) var(--ease) both;
  }

  .sim-url {
    position: relative;
    color: var(--lav);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  /* Marker: wischt als amberfarbener Leuchtstift ein */
  .sim-mark {
    padding: 0.05em 0.1em;
    border-radius: 0.25em;
    background-color: transparent;
    background-image: linear-gradient(var(--amber), var(--amber));
    background-position: 0 0;
    background-repeat: no-repeat;
    background-size: 0% 100%;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    color: inherit;
    font-weight: inherit;
    transition:
      background-size var(--dur-3) var(--ease),
      color var(--dur-2) var(--ease);
  }

  .sim-tap {
    position: absolute;
    top: 50%;
    left: 34%;
    display: grid;
    place-items: center;
    width: 3em;
    height: 3em;
    margin: -1.5em 0 0 -1.5em;
    border: 2px solid var(--white);
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--white) 22%, transparent);
    color: var(--white);
    opacity: 0;
    pointer-events: none;
    transform: scale(1.5);
    transition:
      opacity var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-tap :global(.icon) {
    width: 1.3em;
    height: 1.3em;
    transform: translate(12%, 18%);
  }

  .sim-signals {
    display: grid;
    gap: 0.5em;
    padding-left: 0.75em;
    border-left: 2px solid transparent;
    transition: border-color var(--dur-3) var(--ease);
  }

  .sim-signals li {
    display: flex;
    align-items: flex-start;
    gap: 0.55em;
    font-size: 0.93em;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-signals :global(.icon) {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.12em;
    color: var(--amber);
  }

  .sim-signals strong {
    color: var(--white);
    font-weight: 700;
  }

  .sim-signal-note {
    display: block;
    color: var(--soft);
    font-size: 0.9em;
  }

  .sim-verdict {
    display: flex;
    align-items: center;
    gap: 0.5em;
    justify-self: start;
    padding: 0.5em 0.8em;
    border-radius: 0.7em;
    background-color: var(--amber);
    color: var(--ink);
    font-size: 0.9em;
    font-weight: 700;
    line-height: 1.25;
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-verdict :global(.icon) {
    flex: none;
    width: 1.2em;
    height: 1.2em;
  }

  .sim-compose {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: auto;
    padding: 0.7em 1em 1.1em;
  }

  .sim-compose-field {
    flex: 1;
    padding: 0.5em 0.9em;
    border: 1px solid var(--line);
    border-radius: 1.2em;
    color: color-mix(in srgb, var(--lav) 70%, var(--night));
    font-size: 0.86em;
  }

  .sim-compose-send {
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background-color: var(--aubergine);
    color: var(--lav);
  }

  .sim-compose-send :global(.icon) {
    width: 1em;
    height: 1em;
  }

  .sim-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding: 0.7em 1.4em 0.4em;
    border-top: 1px solid var(--line);
    color: var(--lav);
  }

  .sim-toolbar :global(.icon) {
    width: 1.2em;
    height: 1.2em;
  }

  /* ---------- Ansicht 2: Browser ---------- */

  .sim-browser {
    gap: 0.9em;
    padding: 0.4em 1em 1em;
    opacity: 0;
    pointer-events: none;
    transform: translateX(8%);
  }

  .sim-urlbar {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55em 0.8em;
    border: 1px solid var(--line);
    border-radius: 0.8em;
    background-color: var(--deep);
    color: var(--soft);
    font-size: 0.78em;
  }

  .sim-urlbar span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sim-urlbar :global(.icon) {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    color: var(--amber);
  }

  .sim-error {
    display: grid;
    justify-items: center;
    gap: 0.45em;
    padding-block: 1.6em 0.9em;
    text-align: center;
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-error-icon {
    display: grid;
    place-items: center;
    width: 3.6em;
    height: 3.6em;
    margin-bottom: 0.3em;
    border: 1px solid var(--line);
    border-radius: 50%;
    background-color: var(--aubergine);
    color: var(--lav);
  }

  .sim-error-icon :global(.icon) {
    width: 1.8em;
    height: 1.8em;
  }

  .sim-error-title {
    color: var(--white);
    font-size: 1.12em;
    font-weight: 800;
    line-height: 1.2;
    --casl: 0.6;
  }

  .sim-error-code {
    color: var(--lav);
    font-size: 0.78em;
  }

  .sim-note {
    display: flex;
    align-items: flex-start;
    gap: 0.55em;
    padding: 0.7em 0.8em;
    border: 1px solid color-mix(in srgb, var(--ok) 60%, transparent);
    border-radius: 0.8em;
    background-color: color-mix(in srgb, var(--ok) 12%, transparent);
    color: var(--white);
    font-size: 0.86em;
    line-height: 1.35;
    opacity: 0;
    transform: translateY(0.5em);
    transition:
      opacity var(--dur-3) var(--ease),
      transform var(--dur-3) var(--ease);
  }

  .sim-note :global(.icon) {
    flex: none;
    width: 1.3em;
    height: 1.3em;
    margin-top: 0.05em;
    color: var(--ok);
  }

  .sim-small {
    color: var(--soft);
    font-size: 0.78em;
    line-height: 1.4;
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease);
  }

  /*
   * Zustände
   * Grundzustand im CSS: Zeitleiste auf 0 (nur die SMS). simulator.ts schaltet die Schritte
   * über Klassen am Wurzelelement (.is-zeit, .is-adresse, …) und setzt `data-ready`.
   * Ohne JS oder bei reduzierter Bewegung zeigt der Block weiter unten Schritt 1 vollständig.
   */
  .sim.is-zeit .sim-signals {
    border-left-color: var(--amber);
  }

  .sim.is-zeit [data-mark='zeit'],
  .sim.is-adresse [data-mark='adresse'],
  .sim.is-betrag [data-mark='betrag'] {
    background-size: 100% 100%;
    color: var(--ink);
    font-weight: 650;
  }

  .sim.is-zeit [data-signal='zeit'],
  .sim.is-adresse [data-signal='adresse'],
  .sim.is-betrag [data-signal='betrag'],
  .sim.is-verdict .sim-verdict {
    opacity: 1;
    transform: none;
  }

  .sim.is-tap .sim-tap {
    opacity: 1;
    transform: scale(1);
  }

  .sim.is-press .sim-tap {
    transform: scale(0.78);
  }

  .sim.is-browser .sim-sms {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-8%);
  }

  .sim.is-browser .sim-browser {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }

  .sim.is-error .sim-error,
  .sim.is-note .sim-note {
    opacity: 1;
    transform: none;
  }

  .sim.is-small .sim-small {
    opacity: 1;
  }

  /* Statischer Zustand, solange kein Skript übernommen hat: Schritt 1 vollständig */
  @media (scripting: none), (prefers-reduced-motion: reduce) {
    .sim:not([data-ready]) .sim-mark {
      background-size: 100% 100%;
      color: var(--ink);
      font-weight: 650;
    }

    .sim:not([data-ready]) .sim-signals {
      border-left-color: var(--amber);
    }

    .sim:not([data-ready]) .sim-signals li,
    .sim:not([data-ready]) .sim-verdict {
      opacity: 1;
      transform: none;
    }
  }

  /* Ohne Skripte: beide Ansichten untereinander, keine Bedienelemente */
  @media (scripting: none) {
    .sim-phone {
      aspect-ratio: auto;
    }

    .sim-views {
      display: grid;
    }

    .sim-view {
      position: static;
    }

    .sim-browser {
      border-top: 1px solid var(--line);
      padding-top: 1em;
      opacity: 1;
      transform: none;
    }

    .sim-browser .sim-error,
    .sim-browser .sim-note,
    .sim-browser .sim-small {
      opacity: 1;
      transform: none;
    }

    .sim-controls {
      display: none;
    }
  }

  @keyframes sim-pop {
    from {
      opacity: 0;
      transform: translateY(0.6em) scale(0.97);
    }
  }

  /* ---------- Zeitleiste ---------- */

  .sim-controls {
    display: grid;
    gap: 0.25rem;
  }

  .sim-controls-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .sim-label {
    color: var(--lav);
    font-size: var(--fs-micro);
  }

  .sim-buttons {
    display: flex;
    gap: 0.375rem;
  }

  .sim-step {
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    color: var(--soft);
    font-size: var(--fs-micro);
    font-weight: 650;
    transition:
      background-color var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }

  .sim-step[aria-pressed='true'] {
    border-color: var(--lav);
    background-color: color-mix(in srgb, var(--lav) 18%, transparent);
    color: var(--white);
  }

  .sim-track {
    position: relative;
  }

  /* Stationsmarke in der Mitte der Zeitleiste */
  .sim-track::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 12px;
    border-radius: 1px;
    background-color: var(--border-strong);
    content: '';
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .sim-range {
    display: block;
    width: 100%;
    height: 2.75rem;
    margin: 0;
    background: transparent;
    cursor: grab;
    appearance: none;
    -webkit-appearance: none;
    touch-action: pan-y;
  }

  .sim-range:active {
    cursor: grabbing;
  }

  .sim-range::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--lav) 0 var(--sim-fill, 0%),
      var(--line) var(--sim-fill, 0%) 100%
    );
  }

  .sim-range::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background-color: var(--line);
  }

  .sim-range::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background-color: var(--lav);
  }

  .sim-range::-webkit-slider-thumb {
    position: relative;
    z-index: 1;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: -9px;
    border: 3px solid var(--lav);
    border-radius: 50%;
    background-color: var(--white);
    appearance: none;
    -webkit-appearance: none;
  }

  .sim-range::-moz-range-thumb {
    box-sizing: border-box;
    width: 1.375rem;
    height: 1.375rem;
    border: 3px solid var(--lav);
    border-radius: 50%;
    background-color: var(--white);
  }

  .sim-stations {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    color: var(--lav);
    font-size: var(--fs-micro);
    line-height: 1.35;
  }

  .sim-stations span {
    white-space: nowrap;
  }

  .sim-stations li {
    transition: color var(--dur-2) var(--ease);
  }

  .sim-stations li:global(.is-active) {
    color: var(--white);
  }
</style>
