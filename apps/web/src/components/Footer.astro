---
/**
 * Footer als grosse Bühne: Spalten, Mono-Zeilen und die Wortmarke in voller Breite mit Cursor.
 * Kein Cookie-Banner, weil keine Cookies gesetzt werden.
 */
import Logo from '@psyber/ui/components/Logo.astro';
import { contact, href, isTodo, meta, surveyUrl } from '../config/site.ts';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const anchor = (hash: string) => (home ? hash : href(`/${hash}`));

const columns = [
  {
    title: 'Angebot',
    links: [
      { label: 'Lösungen', href: anchor('#angebot') },
      { label: 'Pakete', href: anchor('#pakete') },
      { label: 'Ablauf', href: anchor('#ablauf') },
    ],
  },
  {
    title: 'PSYber',
    links: [
      { label: 'Maschen', href: anchor('#maschen') },
      { label: 'Über', href: anchor('#ueber') },
      { label: 'Umfrage', href: surveyUrl() },
      { label: 'Checkliste', href: href('/checkliste') },
      { label: 'Kontakt', href: anchor('#kontakt') },
    ],
  },
  {
    title: 'Rechtliches',
    links: [
      { label: 'Impressum', href: href('/impressum') },
      { label: 'Datenschutz', href: href('/datenschutz') },
    ],
  },
];
---

<footer class="site-footer" data-lazy>
  <div class="wrap">
    <div class="stage footer-stage">
      <div class="footer-top">
        <div class="footer-brand">
          <Logo href={href('/')} />
          <p class="footer-claim">{meta.claim}</p>
        </div>

        <nav class="footer-nav" aria-label="Footer">
          {columns.map((column) => (
            <div>
              <h2 class="label-up footer-title">{column.title}</h2>
              <ul>
                {column.links.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div>
            <h2 class="label-up footer-title">Kontakt</h2>
            <ul>
              <li>
                {isTodo(contact.email) ? (
                  <span>{contact.email}</span>
                ) : (
                  <a href={`mailto:${contact.email}`}>{contact.email}</a>
                )}
              </li>
              <li>
                {isTodo(contact.phone) ? (
                  <span>{contact.phone}</span>
                ) : (
                  <a href={`tel:${contact.phone.replace(/\s+/g, '')}`}>{contact.phone}</a>
                )}
              </li>
              <li>
                <span>{contact.region}</span>
              </li>
            </ul>
          </div>
        </nav>
      </div>

      <div class="footer-bottom mono">
        <ul class="footer-lines">
          <li>Kein Cookie-Banner. Weil wir keine Cookies setzen.</li>
          <li>0 Tracking-Pixel, 0 Deepfakes, genau ein Nerd.</li>
          <li>
            Sicherheitslücke gefunden?{' '}
            <a class="link" href={href('/.well-known/security.txt')}>
              /.well-known/security.txt
            </a>
          </li>
          <li>© 2026 PSYber</li>
        </ul>
      </div>

      <p class="footer-word" aria-hidden="true">
        <span class="wordmark">PSYber</span>
        <span class="footer-cursor"></span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(1.25rem, 3vw, 2.5rem) 1.5rem;
    background-color: var(--void);
  }

  .footer-stage {
    overflow: hidden;
    padding: clamp(1.5rem, 0.6rem + 3.6vw, 4.5rem);
    padding-bottom: 0;
    background-image:
      radial-gradient(46rem 30rem at 100% 0%, rgb(182 120 247 / 0.2), transparent 70%),
      radial-gradient(50rem 26rem at 30% 100%, rgb(61 30 134 / 0.55), transparent 70%);
  }

  .footer-top {
    display: grid;
    gap: 3rem;
  }

  .footer-brand {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .footer-claim {
    max-width: 8em;
    color: var(--bone);
    font-size: var(--fs-h3);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-heading);
    line-height: 1;
    text-transform: uppercase;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }

  /* Schmal: Die Kontaktspalte bekommt die ganze Breite (lange Adressen) */
  .footer-nav > div:last-child {
    grid-column: 1 / -1;
  }

  .footer-title {
    margin-bottom: 1rem;
  }

  .footer-nav ul {
    display: grid;
    gap: 0.125rem;
  }

  .footer-nav a,
  .footer-nav span {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--bone);
    font-size: var(--fs-h4);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-2) var(--ease);
  }

  .footer-nav a:hover {
    color: var(--acid);
  }

  .footer-bottom {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--hairline);
    color: var(--ash);
    font-size: var(--fs-micro);
    letter-spacing: 0.02em;
  }

  .footer-lines {
    display: grid;
    gap: 0.5rem;
  }

  .footer-lines .link {
    color: var(--bone);
  }

  /* Wortmarke in voller Breite, dahinter ein Cursor, der auf Eingabe wartet */
  .footer-word {
    display: flex;
    align-items: flex-end;
    gap: 0.06em;
    margin-block: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 3.6vw, 4.5rem);
    font-size: min(21.5vw, 20.5rem);
    line-height: 0.74;
    white-space: nowrap;
  }

  .footer-cursor {
    width: 0.46em;
    height: 0.72em;
    margin-bottom: 0.01em;
    background-color: var(--acid);
    box-shadow: 0 0 0.25em rgb(201 251 82 / 0.5);
    animation: footer-cursor 1.2s steps(1) infinite;
  }

  @keyframes footer-cursor {
    50% {
      opacity: 0;
    }
  }

  @media (min-width: 40rem) {
    .footer-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.5fr);
    }

    .footer-nav > div:last-child {
      grid-column: auto;
    }
  }

  /* Ab Tablet schweben unten die Knöpfe: Platz lassen */
  @media (min-width: 48rem) {
    .site-footer {
      padding-bottom: 5.5rem;
    }
  }

  @media (min-width: 64rem) {
    .footer-top {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }

  @media print {
    .site-footer {
      display: none;
    }
  }
</style>
