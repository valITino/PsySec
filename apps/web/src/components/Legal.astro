---
/**
 * Rahmen für Impressum und Datenschutz: Titel, Entwurfs-Vermerk, Fliesstext.
 */
import Icon from '@psyber/ui/components/Icon.astro';
import Kicker from '@psyber/ui/components/Kicker.astro';

interface Props {
  kicker: string;
  title: string;
  /** Stand des Dokuments, z. B. «November 2026» */
  stand: string;
}

const { kicker, title, stand } = Astro.props;
---

<article class="wrap legal">
  <header class="legal-head">
    <Kicker>{kicker}</Kicker>
    <h1 class="display h1 legal-title">{title}</h1>
    <p class="legal-draft">
      <Icon name="triangle-alert" size={20} />
      <span>
        <strong>Entwurf, rechtlich prüfen lassen.</strong> Stand: {stand}.
      </span>
    </p>
  </header>
  <div class="legal-body">
    <slot />
  </div>
</article>

<style>
  .legal {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: calc(var(--header-h) + clamp(2rem, 6vw, 5rem)) var(--section-y);
  }

  .legal-head {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1.25rem;
  }

  .legal-title {
    font-size: var(--fs-h1);
    overflow-wrap: anywhere;
  }

  .legal-draft {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid color-mix(in srgb, var(--amber) 60%, transparent);
    border-radius: var(--r-input);
    font-size: var(--fs-small);
  }

  .legal-draft :global(.icon) {
    flex: none;
    margin-top: 0.1em;
    color: var(--amber);
  }

  .legal-body {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }

  .legal-body :global(h2) {
    margin-top: 2.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal-body :global(h3) {
    margin-top: 1rem;
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .legal-body :global(ul) {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal-body :global(li::marker) {
    color: var(--acid);
  }

  .legal-body :global(dl) {
    display: grid;
    gap: 0.875rem;
  }

  .legal-body :global(dt) {
    color: var(--ash);
    font-family: var(--ff-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }

  .legal-body :global(dd) {
    color: var(--bone);
  }

  .legal-body :global(.todo) {
    color: var(--amber);
    font-family: var(--ff-mono);
    font-size: 0.92em;
  }

  @media (min-width: 64rem) {
    .legal {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: clamp(2rem, 5vw, 5rem);
    }

    /* Der Titel bleibt stehen, während der Text läuft */
    .legal-head {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
