---
/**
 * Rahmen für Impressum und Datenschutz: Titel, Entwurfs-Vermerk, Fliesstext.
 */
import Icon from '@psyber/ui/components/Icon.astro';
import Kicker from '@psyber/ui/components/Kicker.astro';

interface Props {
  kicker: string;
  title: string;
  /** Stand des Dokuments, z. B. «November 2026» */
  stand: string;
}

const { kicker, title, stand } = Astro.props;
---

<article class="wrap legal">
  <header class="legal-head">
    <Kicker>{kicker}</Kicker>
    <h1 class="display h1 legal-title">{title}</h1>
    <p class="legal-draft">
      <Icon name="triangle-alert" size={20} />
      <span>
        <strong>Entwurf, rechtlich prüfen lassen.</strong> Stand: {stand}.
      </span>
    </p>
  </header>
  <div class="legal-body">
    <slot />
  </div>
</article>

<style>
  .legal {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(2.5rem, 7vw, 5rem) var(--section-y);
  }

  .legal-head {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .legal-title {
    font-size: clamp(2.5rem, 1.4rem + 5.2vw, 5rem);
  }

  .legal-draft {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--amber) 60%, transparent);
    border-radius: 12px;
    font-size: var(--fs-small);
  }

  .legal-draft :global(.icon) {
    flex: none;
    margin-top: 0.1em;
    color: var(--amber);
  }

  .legal-body {
    display: grid;
    gap: 1rem;
    max-width: 42rem;
  }

  .legal-body :global(h2) {
    margin-top: 2rem;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    font-weight: 850;
    line-height: 1.15;
    --casl: 0.7;
  }

  .legal-body :global(h3) {
    margin-top: 1rem;
    font-size: 1.1875rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    line-height: 1.3;
    --casl: 0.5;
  }

  .legal-body :global(ul) {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal-body :global(li::marker) {
    color: var(--lav);
  }

  .legal-body :global(dl) {
    display: grid;
    gap: 0.75rem;
  }

  .legal-body :global(dt) {
    color: var(--lav);
    font-family: var(--ff-mono);
    font-size: var(--fs-meta);
    --mono: 1;
  }

  .legal-body :global(dd) {
    color: var(--white);
  }

  .legal-body :global(.todo) {
    color: var(--amber);
    font-family: var(--ff-mono);
    font-size: 0.92em;
    --mono: 1;
  }
</style>
