{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psyber-web",
  "compatibility_date": "2026-11-01",

  // psyber.tech: reine Auslieferung statischer Dateien aus dist/ (kein Worker-Code).
  // www.psyber.tech leitet eine Redirect Rule auf psyber.tech um (siehe docs/DEPLOY.md).
  // Header und Weiterleitungen kommen aus dist/_headers und dist/_redirects (beim Build erzeugt).
  "assets": {
    "directory": "./dist",
    // /checkliste liefert checkliste.html; ein Slash am Ende wird entfernt.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Nur über die eigene Domain erreichbar.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "psyber.tech", "custom_domain": true }]
}
