{
  "name": "@psyber/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "api.psyber.tech: Cloudflare Worker für Umfrage, Kontakt und anonyme Zähler",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply psyber --local",
    "db:migrate:remote": "wrangler d1 migrations apply psyber --remote",
    "deploy": "wrangler deploy",
    "db:backup": "wrangler d1 export psyber --remote --output ../../reports/psyber-backup.sql"
  },
  "dependencies": {
    "@psyber/survey": "workspace:*",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@psyber/config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0",
    "@cloudflare/vitest-plugin": "^1.7.0"
  }
}
