# Kopieren nach .env (wird nicht committet). Ohne Angaben gelten die Standardwerte:
# `astro dev` nutzt localhost, `astro build` die Produktionsadressen.

# Basis-URL der API für den anonymen Zähler. Dev: http://localhost:8787, Prod: https://api.psyber.tech
# Mit `mock` wird nichts gesendet.
PUBLIC_API_BASE=http://localhost:8787

# Auf dieser Site gibt es kein Formular und darum kein Turnstile. Die Variablen stehen
# der Einheitlichkeit halber in jeder App.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_SITE_PHASE=survey

# Nur nötig, wenn die Sites unter anderen Adressen laufen (z. B. Vorschau auf GitHub Pages).
# PUBLIC_WEB_URL=https://psyber.tech
# PUBLIC_FORMS_URL=https://forms.psyber.tech
# PUBLIC_SURPRISE_URL=https://surprise.psyber.tech
# PUBLIC_PREVIEW=true
