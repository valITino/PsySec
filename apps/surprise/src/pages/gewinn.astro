---
/**
 * surprise.psyber.tech/gewinn: Auflösung des Phishing-Tests aus der Umfrage.
 * Regeln (Auftrag 6.6): nur die eigene Marke, keine Eingabefelder, keine Cookies,
 * Klicks nur als anonyme Summe, freundlich und ohne Beschämung.
 * Ablauf (7.1): Teaser → Glitch → Auflösung. Texte wörtlich aus Abschnitt 7.2.
 */
import Icon from '@psyber/ui/components/Icon.astro';
import Logo from '@psyber/ui/components/Logo.astro';
import PreviewNote from '@psyber/ui/components/PreviewNote.astro';
import AddressReader from '../components/AddressReader.astro';
import Offer from '../components/Offer.astro';
import Teaser from '../components/Teaser.astro';
import Base from '../layouts/Base.astro';
import { sites, web } from '../lib/site.ts';
import noScriptCss from '../styles/no-js.css?url';

const TITLE = 'Erwischt!';

/** Der angeklickte Link; «psyber.tech» wird einmal mit dem Marker hervorgehoben. */
const clicked = [
  { text: 'https://surprise.', mark: false },
  { text: 'psyber.tech', mark: true },
  { text: '/gewinn', mark: false },
];

const signals = [
  {
    icon: 'gift',
    title: 'Ein Gewinn aus dem Nichts',
    text: 'Sie haben an keinem Wettbewerb teilgenommen.',
  },
  {
    icon: 'clock',
    title: 'Zeitdruck: ‹nur heute›',
    text: 'Wer drängt, will verhindern, dass Sie nachdenken.',
  },
  {
    icon: 'link',
    title: 'Die Adresse nicht geprüft',
    text: 'Diesmal war sie echt. Betrüger tarnen ihre Adressen aber geschickt.',
  },
] as const;
---

<Base title="Erwischt! – PSYber" description="Dieser Link war ein Test. Zum Glück nur von uns.">
  <noscript slot="head">
    <link rel="stylesheet" href={noScriptCss} />
  </noscript>

  <Teaser />

  <div class="sp" data-surprise data-api={sites.api}>
    {sites.preview && (
      <PreviewNote>Vorschau: Im Betrieb liegt diese Seite unter surprise.psyber.tech.</PreviewNote>
    )}

    <header class="sp-header wrap">
      <Logo href={web.home} label="PSYber, zu psyber.tech" />
    </header>

    <main id="inhalt">
      <section class="sp-hero net-texture">
        <div class="wrap">
          <h1 class="sp-title display" data-text={TITLE}>
            <span class="sp-title-text">{TITLE}</span>
          </h1>

          <div class="sp-hero-grid">
            <div class="sp-intro">
              <p class="sp-sub">Zum Glück nur von uns.</p>
              <p class="lead">
                Keine Sorge, es ist nichts passiert. Dieser Link war ein Test. Ein echter Betrüger
                hätte Sie jetzt auf eine gefälschte Login- oder Zahlungsseite geführt.
              </p>
            </div>

            <div class="sp-clicked">
              <p class="sp-clicked-label">Diesen Link haben Sie angeklickt:</p>
              <p class="sp-url mono">
                {clicked.map((part) =>
                  part.mark ? (
                    <span class="marker" data-text={part.text}>
                      {part.text}
                    </span>
                  ) : (
                    <span>{part.text}</span>
                  ),
                )}
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="sp-section wrap" aria-labelledby="signale">
        <p class="hexnum" aria-hidden="true">
          0x01
        </p>
        <h2 class="display h2 sp-h2" id="signale">
          Diese drei Signale hätten Sie warnen können
        </h2>
        <ol class="signals">
          {signals.map((signal, index) => (
            <li class="signal">
              <span class="signal-top">
                <span class="signal-icon">
                  <Icon name={signal.icon} size={26} />
                </span>
                <span class="signal-num mono" aria-hidden="true">
                  {index + 1}
                </span>
              </span>
              <h3 class="h4 signal-title">{signal.title}</h3>
              <p class="signal-text">{signal.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="sp-section wrap" aria-labelledby="adressen">
        <div class="lesen">
          <div class="lesen-head">
            <p class="hexnum" aria-hidden="true">
              0x02
            </p>
            <h2 class="display h2 sp-h2" id="adressen">
              Adressen lesen
            </h2>
          </div>
          <div class="lesen-reader">
            <AddressReader labelledby="adressen" />
          </div>
          <div class="lesen-rule">
            <p class="lead">
              Lesen Sie die Adresse bis zum ersten einzelnen ‹/›. Entscheidend ist, was direkt davor
              steht, zum Beispiel ‹psyber.tech›.
            </p>
            <p class="lesen-tip mono">
              <Icon name="smartphone" size={20} />
              <span>
                Auf dem Handy einen Link lange gedrückt halten. Dann sehen Sie die Adresse, bevor
                Sie klicken.
              </span>
            </p>
          </div>
        </div>
      </section>

      <section class="sp-section wrap">
        <p class="sp-statement">
          <span class="sp-statement-strong">Das passiert den meisten Menschen.</span>
          Genau diese Hebel funktionieren bei uns allen, deshalb setzen Betrüger sie ein.
        </p>
      </section>

      <section class="sp-offer wrap">
        <Offer />
      </section>
    </main>

    <footer class="sp-footer">
      <div class="wrap sp-footer-inner">
        <p class="mono">Diese Seite setzt keine Cookies und fragt nichts ab.</p>
        <ul class="sp-footer-links">
          <li>
            <a class="link" href={web.impressum}>
              Impressum
            </a>
          </li>
          <li>
            <a class="link" href={web.datenschutz}>
              Datenschutz
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </div>
</Base>

<script>
  import '../scripts/gewinn.ts';
</script>

<style>
  .sp {
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    flex-direction: column;
  }

  .sp main {
    flex: 1;
  }

  .sp-header {
    display: flex;
    align-items: center;
    height: var(--header-h);
  }

  /* ---------- Auflösung ---------- */

  .sp-hero {
    padding-block: clamp(1.5rem, 5vw, 4rem) clamp(3.5rem, 8vw, 7rem);
  }

  .sp-title {
    position: relative;
    isolation: isolate;
    width: fit-content;
    margin-left: -0.035em;
    font-size: clamp(3.5rem, 19.5vw, 15.5rem);
    letter-spacing: -0.035em;
    line-height: 0.92;
  }

  .sp-title-text {
    display: block;
    animation: sp-jolt var(--sp-half) steps(1, end) var(--sp-cut) both;
  }

  /*
   * Farbkanäle hinter dem Wort: nur während des Glitchs sichtbar. Der leere Alternativtext
   * («/ ''») hält die Kopien aus dem Accessibility-Tree; Browser, die das nicht kennen,
   * verwerfen die Zeile und zeigen den Glitch ohne Farbversatz.
   */
  .sp-title::before,
  .sp-title::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: attr(data-text) / '';
    opacity: 0;
    pointer-events: none;
  }

  .sp-title::before {
    color: var(--crit);
    animation: sp-ghost-a var(--sp-half) steps(1, end) var(--sp-cut) both;
  }

  .sp-title::after {
    color: var(--violet);
    animation: sp-ghost-b var(--sp-half) steps(1, end) var(--sp-cut) both;
  }

  @keyframes sp-jolt {
    0% {
      clip-path: none;
      transform: none;
    }
    2% {
      clip-path: inset(0 0 38% 0);
      transform: translateX(0.05em) skewX(-8deg);
    }
    30% {
      clip-path: inset(22% 0 0 0);
      transform: translateX(-0.03em) skewX(5deg);
    }
    58% {
      clip-path: inset(0 0 12% 0);
      transform: translateX(0.012em);
    }
    80%,
    100% {
      clip-path: none;
      transform: none;
    }
  }

  @keyframes sp-ghost-a {
    0% {
      opacity: 0;
      transform: none;
    }
    2% {
      opacity: 1;
      transform: translateX(-0.075em) skewX(-8deg);
    }
    30% {
      opacity: 1;
      transform: translateX(0.05em);
    }
    58% {
      opacity: 0.9;
      transform: translateX(-0.028em);
    }
    80% {
      opacity: 0.7;
      transform: translateX(0.012em);
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes sp-ghost-b {
    0% {
      opacity: 0;
      transform: none;
    }
    2% {
      opacity: 1;
      transform: translateX(0.085em) skewX(-8deg);
    }
    30% {
      opacity: 1;
      transform: translateX(-0.055em);
    }
    58% {
      opacity: 0.9;
      transform: translateX(0.03em);
    }
    80% {
      opacity: 0.7;
      transform: translateX(-0.012em);
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }

  .sp-hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    margin-top: clamp(1.25rem, 3vw, 2.5rem);
  }

  .sp-intro {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .sp-sub {
    color: var(--lav);
    font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.1;
    --casl: 0.8;
  }

  .sp-clicked {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .sp-clicked-label {
    color: var(--white);
    font-weight: 650;
  }

  .sp-url {
    padding: 1.125rem clamp(1rem, 3.4vw, 1.5rem);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-card);
    background-color: var(--deep);
    color: var(--soft);
    font-size: clamp(0.8125rem, 0.43rem + 1.9vw, 1.1875rem);
    font-weight: 500;
    line-height: 1.6;
    white-space: nowrap;
  }

  /*
   * Marker: wischt einmal von links ein. Grundzustand ist der fertige Marker.
   * Die Kopie in dunkler Schrift liegt als Pseudoelement über dem Wort (für Screenreader
   * stumm, siehe oben; ältere Browser nehmen die erste content-Zeile).
   */
  .marker {
    position: relative;
    display: inline-block;
    color: var(--white);
    font-weight: 750;
  }

  .marker::after {
    position: absolute;
    inset: -0.12em -0.22em;
    display: grid;
    place-items: center;
    border-radius: 0.2em;
    background-color: var(--amber);
    color: var(--ink);
    content: attr(data-text);
    content: attr(data-text) / '';
    animation: sp-wipe 520ms var(--ease) var(--sp-mark) backwards;
  }

  @keyframes sp-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  /* ---------- Sektionen ---------- */

  .sp-section {
    padding-block: clamp(3rem, 1.5rem + 5vw, 6rem);
  }

  .sp-h2 {
    max-width: 14em;
    margin-top: 0.75rem;
  }

  /* ---------- Drei Signale ---------- */

  .signals {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .signal {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background-color: var(--aubergine);
  }

  .signal-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: clamp(0.75rem, 2vw, 1.75rem);
  }

  .signal-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid color-mix(in srgb, var(--amber) 55%, transparent);
    border-radius: var(--r-btn);
    color: var(--amber);
  }

  .signal-icon :global(.icon) {
    width: 1.625rem;
    height: 1.625rem;
  }

  .signal-num {
    color: var(--lav);
    font-size: var(--fs-meta);
    font-weight: 500;
  }

  .signal-title {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
  }

  .signal-text {
    color: var(--soft);
    line-height: 1.5;
  }

  /* ---------- Adressen lesen ---------- */

  .lesen {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .lesen-rule {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .lesen-tip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    max-width: 34em;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-strong);
    color: var(--lav);
    font-size: var(--fs-small);
    line-height: 1.55;
  }

  .lesen-tip :global(.icon) {
    margin-top: 0.125rem;
  }

  /* ---------- Entlastung ---------- */

  .sp-statement {
    max-width: 21em;
    color: var(--lav);
    font-size: clamp(1.625rem, 1rem + 2.9vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.12;
    text-wrap: balance;
    --casl: 0.8;
  }

  .sp-statement-strong {
    display: block;
    color: var(--white);
  }

  /* ---------- Angebot und Footer ---------- */

  .sp-offer {
    padding-block: clamp(1rem, 3vw, 2rem) clamp(4rem, 9vw, 7rem);
  }

  .sp-footer {
    border-top: 1px solid var(--line);
    padding-block: 1.75rem 2rem;
    color: var(--lav);
    font-size: var(--fs-micro);
  }

  .sp-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .sp-footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .sp-footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--fs-small);
  }

  @media (min-width: 48rem) {
    .signals {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .sp-hero-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
      column-gap: clamp(2rem, 6vw, 5rem);
    }

    .sp-clicked {
      padding-top: 0.375rem;
    }

    .lesen {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 6vw, 5rem);
    }

    .lesen-head {
      grid-column: 1;
      grid-row: 1;
    }

    .lesen-rule {
      grid-column: 1;
      grid-row: 2;
    }

    .lesen-reader {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-title::before,
    .sp-title::after {
      content: none;
    }
  }
</style>
