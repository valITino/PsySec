---
/**
 * Teaser (höchstens 1.2 s) und Glitch-Übergang (rund 400 ms) als reine CSS-Zeitleiste.
 * Die Zeiten stehen als --sp-* in src/styles/global.css. Das Skript braucht es nur zum
 * Überspringen. Ohne JS (no-js.css) und bei reduzierter Bewegung erscheint sofort die Auflösung.
 * Der Teaser ist reine Inszenierung und für Screenreader versteckt: Sie hören gleich die Auflösung.
 */
import Icon from '@psyber/ui/components/Icon.astro';
---

<div class="teaser" data-teaser aria-hidden="true">
  <div class="teaser-inner">
    <span class="teaser-icon">
      <Icon name="gift" size={44} strokeWidth={1.5} />
    </span>
    <p class="teaser-text">Ihr Gutschein wird vorbereitet&nbsp;…</p>
    <span class="teaser-bar">
      <span class="teaser-fill"></span>
    </span>
  </div>
</div>
<div class="glitch" data-glitch aria-hidden="true"></div>

<style>
  .teaser {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    background-color: var(--void);
    animation: sp-teaser-off 1ms linear var(--sp-cut) forwards;
  }

  .teaser-inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    width: min(100%, 22rem);
    text-align: center;
    animation: sp-tear var(--sp-half) steps(1, end) var(--sp-hold) both;
  }

  .teaser-icon {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    border: 1px solid var(--steel);
    border-radius: 50%;
    background-color: var(--carbon);
    color: var(--acid);
    box-shadow: var(--glow-acid);
  }

  .teaser-icon :global(.icon) {
    width: 2.75rem;
    height: 2.75rem;
  }

  .teaser-text {
    color: var(--fg-strong);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .teaser-bar {
    display: block;
    width: 100%;
    height: 0.25rem;
    overflow: hidden;
    border-radius: var(--r-pill);
    background-color: var(--hairline);
  }

  .teaser-fill {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background-color: var(--acid);
    transform-origin: left center;
    animation: sp-fill calc(var(--sp-hold) - 60ms) cubic-bezier(0.3, 0.1, 0.3, 1) both;
  }

  /* Scanlines und Störstreifen über dem Schnitt */
  .glitch {
    position: fixed;
    inset: 0;
    z-index: 95;
    overflow: hidden;
    background-image: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--fg-strong) 9%, transparent) 0 1px,
      transparent 1px 4px
    );
    opacity: 0;
    pointer-events: none;
    animation: sp-scan var(--sp-glitch) steps(1, end) var(--sp-hold) both;
  }

  .glitch::before,
  .glitch::after {
    position: absolute;
    right: 0;
    left: 0;
    content: '';
  }

  .glitch::before {
    top: 0;
    height: 14vh;
    background-color: color-mix(in srgb, var(--acid) 38%, transparent);
    animation: sp-band-a var(--sp-glitch) steps(1, end) var(--sp-hold) both;
  }

  .glitch::after {
    top: 0;
    height: 5vh;
    background-color: color-mix(in srgb, var(--crit) 34%, transparent);
    animation: sp-band-b var(--sp-glitch) steps(1, end) var(--sp-hold) both;
  }

  /* Beide Keyframes gleich: ab dem Schnitt ist der Teaser weg (ohne Rundungsfehler am Ende). */
  @keyframes sp-teaser-off {
    from,
    to {
      visibility: hidden;
    }
  }

  @keyframes sp-fill {
    from {
      transform: scaleX(0);
    }
  }

  /* Der Teaser reisst: Streifen versetzt, Farbkanäle laufen auseinander */
  @keyframes sp-tear {
    0% {
      clip-path: inset(0);
      filter: none;
      transform: none;
    }
    2% {
      clip-path: inset(0 0 46% 0);
      filter: drop-shadow(-5px 0 0 var(--crit)) drop-shadow(5px 0 0 var(--acid));
      transform: translateX(-14px) skewX(-7deg);
    }
    24% {
      clip-path: inset(34% 0 12% 0);
      filter: drop-shadow(7px 0 0 var(--crit)) drop-shadow(-7px 0 0 var(--acid));
      transform: translateX(18px);
    }
    46% {
      clip-path: inset(8% 0 30% 0);
      filter: drop-shadow(-9px 0 0 var(--crit)) drop-shadow(9px 0 0 var(--acid));
      transform: translateX(-8px) skewX(9deg);
    }
    68% {
      clip-path: inset(58% 0 4% 0);
      filter: drop-shadow(12px 0 0 var(--crit)) drop-shadow(-12px 0 0 var(--acid));
      transform: translateX(26px) scaleY(1.04);
    }
    86%,
    100% {
      clip-path: inset(20% 0 62% 0);
      filter: drop-shadow(-16px 0 0 var(--crit)) drop-shadow(16px 0 0 var(--acid));
      transform: translateX(-30px) skewX(-12deg);
    }
  }

  @keyframes sp-scan {
    0% {
      opacity: 0;
    }
    2% {
      opacity: 0.55;
    }
    24% {
      opacity: 1;
    }
    50% {
      opacity: 0.9;
    }
    70% {
      opacity: 0.55;
    }
    88% {
      opacity: 0.25;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes sp-band-a {
    0% {
      transform: translateY(-20vh);
    }
    2% {
      transform: translateY(62vh);
    }
    24% {
      transform: translateY(18vh);
    }
    50% {
      transform: translateY(74vh);
    }
    70% {
      transform: translateY(38vh);
    }
    88%,
    100% {
      transform: translateY(-20vh);
    }
  }

  @keyframes sp-band-b {
    0% {
      transform: translateY(-10vh);
    }
    2% {
      transform: translateY(24vh);
    }
    24% {
      transform: translateY(81vh);
    }
    50% {
      transform: translateY(46vh);
    }
    70% {
      transform: translateY(9vh);
    }
    88%,
    100% {
      transform: translateY(-10vh);
    }
  }

  @media (min-width: 48rem) {
    .teaser-inner {
      gap: 1.75rem;
      width: min(100%, 26rem);
    }

    .teaser-icon {
      width: 6.5rem;
      height: 6.5rem;
    }

    .teaser-icon :global(.icon) {
      width: 3.25rem;
      height: 3.25rem;
    }

    .teaser-text {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser,
    .glitch {
      display: none;
    }
  }

  @media print {
    .teaser,
    .glitch {
      display: none;
    }
  }
</style>
