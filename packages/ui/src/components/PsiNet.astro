---
/**
 * Key Visual «Psi-Netz»: ein Psi aus Netzwerkknoten.
 * - `animated`: Knoten pulsieren versetzt, die Signalbögen senden nacheinander (Loop rund 3 s).
 *   Bei reduzierter Bewegung bleibt alles statisch.
 * - Farben über CSS-Variablen: --psi-line, --psi-node, --psi-bg (Rand der Knoten = Hintergrund).
 * - Für die Neigung bei feinem Pointer: `initPsiTilt()` aus `@psyber/ui/motion/psi-net`.
 */
import {
  PSI_NET_VIEWBOX,
  amberEnds,
  arcPath,
  crossPath,
  shellPoints,
  sideNodes,
  signalArcs,
  stem,
  tip,
  whiteNodes,
} from '../lib/psi-net-data.ts';

interface Props {
  class?: string;
  animated?: boolean;
  /**
   * Feine Variante für sehr grosse Darstellung (Hintergrund): Linien behalten ihre Strichstärke
   * in Pixeln, die Knoten sind kleiner. So wirkt das Netz gross, aber nicht schwer.
   */
  fine?: boolean;
  /** Zugänglicher Name. Ohne Angabe ist das Netz Dekoration. */
  label?: string;
}

const { class: className, animated = false, fine = false, label } = Astro.props;
const radius = fine ? { node: 0.55, side: 0.4, end: 0.95 } : { node: 1.5, side: 1, end: 2.5 };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={PSI_NET_VIEWBOX}
  class:list={['psi-net', { 'is-animated': animated, 'is-fine': fine }, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  data-psi-net
>
  <path class="psi-cross" d={crossPath}></path>
  <g class="psi-main">
    <polyline points={shellPoints}></polyline>
    <path
      d={`M${stem.x} ${stem.top}V${stem.bottom}M${sideNodes[0]![0]} ${sideNodes[0]![1]}H${sideNodes[1]![0]}`}
    ></path>
  </g>
  <g class="psi-nodes">
    {whiteNodes.map(([x, y]) => (
      <circle class="psi-node" cx={x} cy={y} r={radius.node} />
    ))}
    {sideNodes.map(([x, y]) => (
      <circle class="psi-node psi-node-side" cx={x} cy={y} r={radius.side} />
    ))}
  </g>
  <g class="psi-ends">
    {amberEnds.map(([x, y]) => (
      <circle class="psi-end" cx={x} cy={y} r={radius.end} />
    ))}
  </g>
  <g class="psi-arcs" data-tip={`${tip[0]},${tip[1]}`}>
    {signalArcs.map(({ r }, index) => (
      <path class={`psi-arc psi-arc-${index + 1}`} d={arcPath(r)} />
    ))}
  </g>
</svg>

<style is:global>
  .psi-net {
    display: block;
    overflow: visible;
  }

  .psi-net .psi-main {
    fill: none;
    stroke: var(--psi-line, var(--lav));
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.15;
  }

  .psi-net .psi-cross {
    fill: none;
    opacity: 0.45;
    stroke: var(--psi-line, var(--lav));
    stroke-linecap: round;
    stroke-width: 0.6;
  }

  .psi-net .psi-node,
  .psi-net .psi-end {
    stroke: var(--psi-bg, var(--bg));
    stroke-width: 0.9;
    transform-box: fill-box;
    transform-origin: center;
  }

  .psi-net .psi-node {
    fill: var(--psi-node, var(--white));
  }

  .psi-net .psi-end {
    fill: var(--amber);
  }

  .psi-net .psi-arc {
    fill: none;
    stroke: var(--amber);
    stroke-linecap: round;
    stroke-width: 1.15;
  }

  /* Feine Variante: Strichstärken in Bildschirm-Pixeln */
  .psi-net.is-fine .psi-main > *,
  .psi-net.is-fine .psi-arc {
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke;
  }

  .psi-net.is-fine .psi-cross {
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .psi-net.is-fine .psi-node,
  .psi-net.is-fine .psi-end {
    stroke-width: 0;
  }

  .psi-net .psi-arc-1 {
    --o: 1;
    opacity: 1;
  }

  .psi-net .psi-arc-2 {
    --o: 0.65;
    opacity: 0.65;
  }

  .psi-net .psi-arc-3 {
    --o: 0.35;
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    .psi-net.is-animated .psi-node {
      animation: psi-pulse 3s ease-in-out infinite;
    }

    .psi-net.is-animated .psi-node:nth-child(5n + 1) {
      animation-delay: -0.2s;
    }

    .psi-net.is-animated .psi-node:nth-child(5n + 2) {
      animation-delay: -1.4s;
    }

    .psi-net.is-animated .psi-node:nth-child(5n + 3) {
      animation-delay: -0.8s;
    }

    .psi-net.is-animated .psi-node:nth-child(5n + 4) {
      animation-delay: -2.3s;
    }

    .psi-net.is-animated .psi-node:nth-child(5n) {
      animation-delay: -1.9s;
    }

    .psi-net.is-animated .psi-end {
      animation: psi-pulse 3s ease-in-out infinite;
    }

    .psi-net.is-animated .psi-arc {
      animation: psi-signal 3s ease-in-out infinite;
    }

    .psi-net.is-animated .psi-arc-2 {
      animation-delay: 0.22s;
    }

    .psi-net.is-animated .psi-arc-3 {
      animation-delay: 0.44s;
    }

    /* Ausserhalb des Viewports ruht die Animation (siehe motion/psi-net.ts) */
    .psi-net.is-paused * {
      animation-play-state: paused;
    }
  }

  @keyframes psi-pulse {
    0%,
    100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.4);
    }
  }

  @keyframes psi-signal {
    0% {
      opacity: 0.08;
    }

    18%,
    46% {
      opacity: var(--o);
    }

    78%,
    100% {
      opacity: 0.08;
    }
  }
</style>
