---
/**
 * Schmaler Hinweis in der Vorschau (z. B. GitHub Pages). Der Text kommt per Slot.
 * Die Apps zeigen ihn nur, wenn PUBLIC_PREVIEW=true gesetzt ist.
 */
---

<p class="preview-note mono" data-preview-note>
  <span class="preview-dot" aria-hidden="true"></span>
  <span>
    <slot>Vorschau: Formulare und Umfrage speichern hier nichts.</slot>
  </span>
</p>

<style>
  /* Bleibt oben stehen; eine Zeile, damit die Höhe feststeht (der Header rückt darunter). */
  .preview-note {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 1.75rem;
    padding-inline: var(--gutter);
    background-color: var(--amber);
    color: var(--ink);
    font-family: var(--ff-sans);
    font-size: var(--fs-micro);
    font-weight: 600;
    line-height: 1.2;
  }

  .preview-note span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .preview-dot {
    flex: none;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background-color: var(--ink);
  }

  @media print {
    .preview-note {
      display: none;
    }
  }
</style>
