---
/** Kleine Pille in gesperrten Versalien, z. B. für Themen und Hebel. `solid` hebt hervor («Neu»). */
interface Props {
  tone?: 'default' | 'amber' | 'solid';
  class?: string;
  as?: 'span' | 'li';
}

const { tone = 'default', class: className, as: Tag = 'span' } = Astro.props;
---

<Tag
  class:list={['tag', { 'tag-amber': tone === 'amber', 'tag-solid': tone === 'solid' }, className]}
>
  <slot />
</Tag>
