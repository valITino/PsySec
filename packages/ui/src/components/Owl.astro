---
/**
 * Die Eule aus dem Logo-Kit, in vier Mimiken: blick (Standard), skeptisch, erwischt, genervt.
 * Ohne `label` ist sie Dekoration.
 */
import erwischt from '../brand/owl-erwischt.svg?url';
import genervt from '../brand/owl-genervt.svg?url';
import skeptisch from '../brand/owl-skeptisch.svg?url';
import blick from '../brand/owl.svg?url';

interface Props {
  mood?: 'blick' | 'skeptisch' | 'erwischt' | 'genervt';
  class?: string;
  label?: string;
  /** Erst laden, wenn das Bild in die Nähe des Bildschirms kommt (Standard) */
  lazy?: boolean;
}

const { mood = 'blick', class: className, label = '', lazy = true } = Astro.props;
const sources = { blick, skeptisch, erwischt, genervt };
---

<img
  class:list={['owl', className]}
  src={sources[mood]}
  width="459"
  height="562"
  alt={label}
  loading={lazy ? 'lazy' : 'eager'}
  decoding="async"
/>
