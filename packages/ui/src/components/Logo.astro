---
/** Psi-Icon und Wortmarke, optional als Link. */
import PsiIcon from './PsiIcon.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  href?: string;
  /** Höhe des Icons in Pixeln */
  size?: number;
  class?: string;
  /** Zugänglicher Name des Links */
  label?: string;
}

const { href, size = 26, class: className, label = 'PSYber, zur Startseite' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['logo', className]} href={href} aria-label={href ? label : undefined}>
  <PsiIcon size={size} class="logo-icon" />
  <Wordmark class="logo-word" />
</Tag>
