---
/**
 * Psi aus einer Linie: Icon für Header und Favicon.
 * Ohne `label` ist es Dekoration.
 */
interface Props {
  /** Höhe in Pixeln; die Breite folgt dem Seitenverhältnis 12:14 */
  size?: number;
  class?: string;
  label?: string;
}

const { size = 24, class: className, label } = Astro.props;
const width = Math.round(((size * 12) / 14) * 100) / 100;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 12 14"
  width={width}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['psi-icon', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d="M2 2.2 C2 7 4 9.2 6 9.2 C8 9.2 10 7 10 2.2 M6 0.8 V13.2"></path>
</svg>
