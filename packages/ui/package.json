{
  "name": "@psyber/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PSYber Designsystem: Tokens, Schrift, Logo und Eule, Buttons, Karten, Motion-Helfer",
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*",
    "./brand/*": "./src/brand/*",
    "./motion": "./src/motion/index.ts",
    "./motion/*": "./src/motion/*.ts",
    "./icons": "./src/icons/index.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "astro check",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@psyber/config": "workspace:*",
    "astro": "^7.4.10",
    "lucide-static": "^1.71.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.astro"
  ]
}
